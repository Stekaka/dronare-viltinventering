---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
}

const { title, description, ogImage = '/media/og-image.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#2b3324" />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>
		
		<!-- SEO Meta Tags -->
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="sv_SE" />
		<meta property="og:site_name" content="Älginventering.se" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Karla:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
		
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ProfessionalService',
			name: 'Älginventering.se',
			description: 'Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis.',
			url: 'https://älginventering.se',
			telephone: '0709-780908',
			email: 'info@dronarkompaniet.se',
			areaServed: {
				'@type': 'Country',
				name: 'Sverige'
			},
			parentOrganization: {
				'@type': 'Organization',
				name: 'Drönarkompaniet',
				url: 'https://www.dronarkompaniet.se'
			}
		})} />
	</head>
	<body>
		<!-- Header -->
		<header class="site-header">
			<a href="/" class="site-logo">
				<span style="font: 700 24px 'Spectral', serif; color: #2b3324;">Älginventering</span>
			</a>
			<nav aria-label="Huvudmeny" class="site-nav">
				<a href="/metodik" class:list={['nav-link', { active: currentPath === '/metodik' }]}>Metodik</a>
				<a href="/kostnad" class:list={['nav-link', { active: currentPath === '/kostnad' }]}>Kostnad</a>
				<a href="/jamfor-metoder" class:list={['nav-link', { active: currentPath === '/jamfor-metoder' }]}>Jämför</a>
				<a href="/kontakt" class="site-cta">Begär offert</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="site-footer">
			<div>
				<span style="font: 700 19px 'Spectral', serif; color: #efe8d8; display: block; margin-bottom: 16px;">Älginventering.se</span>
				<p style="font: 400 13.5px/1.6 'Karla', sans-serif; color: #a39a7c; max-width: 280px; margin: 0;">
					Drönarbaserad viltinventering. Utförs av <a href="https://www.dronarkompaniet.se" target="_blank" rel="noopener" style="color: #d8d2bc; text-decoration: underline;">Drönarkompaniet</a>.
				</p>
			</div>
			<div>
				<span class="footer-heading">Tjänster</span>
				<div class="footer-links">
					<a href="/metodik">Metodik</a>
					<a href="/kostnad">Kostnad & priser</a>
					<a href="/jamfor-metoder">Jämför metoder</a>
					<a href="/case">Senaste uppdrag</a>
				</div>
			</div>
			<div>
				<span class="footer-heading">Målgrupper</span>
				<div class="footer-links">
					<a href="/for/jaktlag">Jaktlag</a>
					<a href="/for/aso">ÄSO</a>
					<a href="/for/afo">ÄFO</a>
					<a href="/for/markagare">Markägare</a>
				</div>
			</div>
			<div>
				<span class="footer-heading">Kontakt</span>
				<div class="footer-links">
					<span style="color: #d8d2bc; font: 400 14px 'Karla', sans-serif;">info@dronarkompaniet.se</span>
					<span style="color: #d8d2bc; font: 400 14px 'Karla', sans-serif;">0709-780908</span>
					<span style="color: #d8d2bc; font: 400 14px 'Karla', sans-serif;">Hela Sverige</span>
					<a href="https://viltanalys.se" target="_blank" rel="noopener" style="color: #c9973f; text-decoration: none; font: 600 13px 'Karla', sans-serif; margin-top: 6px; display: block;">
						Rapportsystemet Viltanalys ↗
					</a>
				</div>
			</div>
		</footer>
		
		<style>
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				row-gap: 12px;
				padding: 20px clamp(20px, 6vw, 64px);
				background: #efe8d8;
				border-bottom: 2px solid #2b3324;
				position: sticky;
				top: 0;
				z-index: 10;
			}
			
			.site-logo {
				display: flex;
				align-items: baseline;
				gap: 10px;
				text-decoration: none;
				flex: none;
			}
			
			.site-nav {
				display: flex;
				align-items: center;
				gap: 34px;
				flex-wrap: wrap;
				row-gap: 10px;
			}
			
			.nav-link {
				text-decoration: none;
				font: 600 13.5px 'Karla', sans-serif;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				color: #2b3324;
			}
			
			.nav-link.active {
				color: #7a5230;
				border-bottom: 2px solid #7a5230;
				padding-bottom: 2px;
			}
			
			.site-cta {
				text-decoration: none;
				border: 1.5px solid #2b3324;
				color: #2b3324;
				padding: 10px 22px;
				font: 600 13px 'Karla', sans-serif;
				letter-spacing: 0.02em;
				white-space: nowrap;
			}
			
			.site-footer {
				padding: 56px clamp(20px, 6vw, 64px);
				background: #242b1e;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 40px;
			}
			
			.footer-heading {
				font: 600 12px 'Karla', sans-serif;
				color: #7a7256;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				display: block;
				margin-bottom: 16px;
			}
			
			.footer-links {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			
			.footer-links a {
				color: #d8d2bc;
				text-decoration: none;
				font: 400 14px 'Karla', sans-serif;
			}
			
			@media (max-width: 760px) {
				.site-header {
					padding: 16px 20px;
				}
				.site-nav {
					gap: 16px 20px;
				}
				.nav-link {
					font-size: 12.5px !important;
				}
				.site-cta {
					padding: 9px 16px;
					font-size: 12px;
				}
			}
		</style>
	</body>
</html>
