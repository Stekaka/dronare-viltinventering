---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	ogImage?: string;
}

const { title, description, ogImage = '/media/og-image.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="sv">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#141414" />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>
		
		<!-- SEO Meta Tags -->
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="sv_SE" />
		<meta property="og:site_name" content="Älginventering.se" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
		
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'ProfessionalService',
			name: 'Älginventering.se',
			description: 'Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis.',
			url: 'https://älginventering.se',
			telephone: '0709-780908',
			email: 'info@dronarkompaniet.se',
			areaServed: {
				'@type': 'Country',
				name: 'Sverige'
			},
			parentOrganization: {
				'@type': 'Organization',
				name: 'Drönarkompaniet',
				url: 'https://www.dronarkompaniet.se'
			}
		})} />
	</head>
	<body>
		<!-- Header -->
		<header class="sticky top-0 z-50 bg-bg/95 backdrop-blur-lg border-b border-border">
			<nav class="container-site py-4">
				<div class="flex items-center justify-between">
					<a href="/" class="text-lg font-semibold text-text-primary">
						älginventering.se
					</a>
					<div class="hidden md:flex items-center gap-8">
						<a href="/metodik" class="text-sm text-text-muted hover:text-text-primary transition-colors">Metodik</a>
						<a href="/kostnad" class="text-sm text-text-muted hover:text-text-primary transition-colors">Kostnad</a>
						<a href="/jamfor-metoder" class="text-sm text-text-muted hover:text-text-primary transition-colors">Jämför</a>
						<a href="/kontakt" class="btn-primary text-sm">Boka samtal</a>
					</div>
					<button id="mobile-menu-toggle" class="md:hidden text-text-primary">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
					</button>
				</div>
				<div id="mobile-menu" class="hidden md:hidden mt-4 space-y-3">
					<a href="/metodik" class="block text-sm text-text-muted hover:text-text-primary transition-colors">Metodik</a>
					<a href="/kostnad" class="block text-sm text-text-muted hover:text-text-primary transition-colors">Kostnad</a>
					<a href="/jamfor-metoder" class="block text-sm text-text-muted hover:text-text-primary transition-colors">Jämför</a>
					<a href="/kontakt" class="block text-sm text-text-primary">Boka samtal</a>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="border-t border-border mt-32">
			<div class="container-site py-16">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
					<div>
						<h3 class="text-base font-semibold text-text-primary mb-4">älginventering.se</h3>
						<p class="text-sm text-text-muted leading-relaxed">
							Drönarbaserad viltinventering. Utförs av <a href="https://www.dronarkompaniet.se" target="_blank" rel="noopener" class="text-text-primary hover:underline">Drönarkompaniet</a>.
						</p>
						<p class="text-sm text-text-muted mt-4">
							Drivs med <a href="https://viltanalys.se" target="_blank" rel="noopener" class="text-text-primary hover:underline">Viltanalys</a>
						</p>
					</div>
					<div>
						<h4 class="text-sm font-medium text-text-primary mb-4">Tjänster</h4>
						<ul class="space-y-2">
							<li><a href="/metodik" class="text-sm text-text-muted hover:text-text-primary transition-colors">Metodik</a></li>
							<li><a href="/kostnad" class="text-sm text-text-muted hover:text-text-primary transition-colors">Kostnad</a></li>
							<li><a href="/jamfor-metoder" class="text-sm text-text-muted hover:text-text-primary transition-colors">Jämför metoder</a></li>
							<li><a href="/case" class="text-sm text-text-muted hover:text-text-primary transition-colors">Case</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-sm font-medium text-text-primary mb-4">För dig</h4>
						<ul class="space-y-2">
							<li><a href="/for/jaktlag" class="text-sm text-text-muted hover:text-text-primary transition-colors">Jaktlag</a></li>
							<li><a href="/for/aso" class="text-sm text-text-muted hover:text-text-primary transition-colors">ÄSO</a></li>
							<li><a href="/for/afo" class="text-sm text-text-muted hover:text-text-primary transition-colors">ÄFO</a></li>
							<li><a href="/for/markagare" class="text-sm text-text-muted hover:text-text-primary transition-colors">Markägare</a></li>
						</ul>
					</div>
					<div>
						<h4 class="text-sm font-medium text-text-primary mb-4">Kontakt</h4>
						<ul class="space-y-2">
							<li class="text-sm text-text-muted">0709-780908</li>
							<li class="text-sm text-text-muted">info@dronarkompaniet.se</li>
							<li><a href="https://dronarkompaniet.se" target="_blank" rel="noopener" class="text-sm text-text-muted hover:text-text-primary transition-colors">Drönarkompaniet.se</a></li>
						</ul>
					</div>
				</div>
				<div class="pt-8 border-t border-border text-sm text-center text-text-muted">
					<p>&copy; {new Date().getFullYear()} Drönarkompaniet Norden AB</p>
				</div>
			</div>
		</footer>
		
		<script>
			const toggle = document.getElementById('mobile-menu-toggle');
			const menu = document.getElementById('mobile-menu');
			
			toggle?.addEventListener('click', () => {
				menu?.classList.toggle('hidden');
			});
		</script>
	</body>
</html>
