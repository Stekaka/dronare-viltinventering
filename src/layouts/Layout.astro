---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-default.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="sv_SE" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Älginventering med Termisk Drönare",
        "image": "https://älginventering.se/images/og-default.jpg",
        "description": "Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning. I linje med SLU 2026.",
        "telephone": "+46709780908",
        "url": "https://älginventering.se",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "SE"
        },
        "parentOrganization": {
          "@type": "Organization",
          "name": "Drönarkompaniet Norden AB",
          "url": "https://dronarkompaniet.se"
        },
        "priceRange": "$$",
        "serviceArea": {
          "@type": "Country",
          "name": "Sverige"
        }
      }
    </script>
    
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Älginventering med Drönare",
        "provider": {
          "@type": "LocalBusiness",
          "name": "Drönarkompaniet Norden AB"
        },
        "areaServed": {
          "@type": "Country",
          "name": "Sverige"
        },
        "description": "Provyteinventering av älg med termisk drönare. Täthetsskattning med konfidensintervall enligt vetenskaplig metodik i linje med SLU:s utvärdering 2026."
      }
    </script>
    
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <header class="sticky top-0 z-50 bg-white border-b border-stone-200 shadow-sm">
      <nav class="container-custom py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-2xl font-bold text-emerald-800">
            Älginventering<span class="text-emerald-600">.se</span>
          </a>
          
          <button
            id="mobile-menu-button"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-stone-700 hover:text-emerald-700 hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-emerald-600"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Öppna huvudmeny</span>
            <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
          
          <div class="hidden md:flex md:items-center md:space-x-6">
            <a href="/metodik" class="text-stone-700 hover:text-emerald-700 font-medium transition-colors">Metodik</a>
            <a href="/kostnad" class="text-stone-700 hover:text-emerald-700 font-medium transition-colors">Kostnad</a>
            <a href="/jamfor-metoder" class="text-stone-700 hover:text-emerald-700 font-medium transition-colors">Jämför metoder</a>
            <div class="relative group">
              <button class="text-stone-700 hover:text-emerald-700 font-medium transition-colors inline-flex items-center">
                För dig
                <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="py-1">
                  <a href="/for/jaktlag" class="block px-4 py-2 text-sm text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">Jaktlag</a>
                  <a href="/for/aso" class="block px-4 py-2 text-sm text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">ÄSO</a>
                  <a href="/for/afo" class="block px-4 py-2 text-sm text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">ÄFO</a>
                  <a href="/for/markagare" class="block px-4 py-2 text-sm text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">Markägare</a>
                </div>
              </div>
            </div>
            <a href="/faq" class="text-stone-700 hover:text-emerald-700 font-medium transition-colors">FAQ</a>
            <a href="/kontakt" class="btn-primary">Boka samtal</a>
          </div>
        </div>
        
        <!-- Mobile menu -->
        <div class="hidden md:hidden" id="mobile-menu">
          <div class="px-2 pt-2 pb-3 space-y-1">
            <a href="/metodik" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">Metodik</a>
            <a href="/kostnad" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">Kostnad</a>
            <a href="/jamfor-metoder" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">Jämför metoder</a>
            <a href="/for/jaktlag" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">För jaktlag</a>
            <a href="/for/aso" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">För ÄSO</a>
            <a href="/for/afo" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">För ÄFO</a>
            <a href="/for/markagare" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">För markägare</a>
            <a href="/faq" class="block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-emerald-700 hover:bg-stone-100">FAQ</a>
            <a href="/kontakt" class="block px-3 py-2 rounded-md text-base font-medium text-white bg-emerald-700 hover:bg-emerald-800">Boka samtal</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-stone-900 text-stone-300 mt-24">
      <div class="container-custom py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <h3 class="text-white font-bold text-lg mb-4">Älginventering.se</h3>
            <p class="text-sm">
              Drönarkompaniet Norden AB<br />
              Termisk älginventering enligt vetenskaplig metodik
            </p>
          </div>
          
          <div>
            <h4 class="text-white font-semibold mb-4">Tjänster</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/metodik" class="hover:text-white transition-colors">Metodik</a></li>
              <li><a href="/kostnad" class="hover:text-white transition-colors">Kostnad</a></li>
              <li><a href="/jamfor-metoder" class="hover:text-white transition-colors">Jämför metoder</a></li>
              <li><a href="/case" class="hover:text-white transition-colors">Case & Referens</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-white font-semibold mb-4">För dig</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/for/jaktlag" class="hover:text-white transition-colors">Jaktlag</a></li>
              <li><a href="/for/aso" class="hover:text-white transition-colors">ÄSO</a></li>
              <li><a href="/for/afo" class="hover:text-white transition-colors">ÄFO</a></li>
              <li><a href="/for/markagare" class="hover:text-white transition-colors">Markägare</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-white font-semibold mb-4">Kontakt</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="tel:+46709780908" class="hover:text-white transition-colors">0709-780 908</a></li>
              <li><a href="mailto:info@dronarkompaniet.se" class="hover:text-white transition-colors">info@dronarkompaniet.se</a></li>
              <li><a href="https://dronarkompaniet.se" target="_blank" rel="noopener" class="hover:text-white transition-colors">Drönarkompaniet.se</a></li>
            </ul>
          </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-stone-800 text-sm text-center">
          <p>&copy; {new Date().getFullYear()} Drönarkompaniet Norden AB. Alla rättigheter förbehållna.</p>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const button = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      
      button?.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', (!expanded).toString());
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
