---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-default.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="sv_SE" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Älginventering med Termisk Drönare",
        "image": "https://älginventering.se/images/og-default.jpg",
        "description": "Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning. I linje med SLU 2026.",
        "telephone": "+46709780908",
        "url": "https://älginventering.se",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "SE"
        },
        "parentOrganization": {
          "@type": "Organization",
          "name": "Drönarkompaniet Norden AB",
          "url": "https://dronarkompaniet.se"
        },
        "priceRange": "$$",
        "serviceArea": {
          "@type": "Country",
          "name": "Sverige"
        }
      }
    </script>
    
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Älginventering med Drönare",
        "provider": {
          "@type": "LocalBusiness",
          "name": "Drönarkompaniet Norden AB"
        },
        "areaServed": {
          "@type": "Country",
          "name": "Sverige"
        },
        "description": "Provyteinventering av älg med termisk drönare. Täthetsskattning med konfidensintervall enligt vetenskaplig metodik i linje med SLU:s utvärdering 2026."
      }
    </script>
  </head>
  <body>
    <!-- Compact Navigation -->
    <header class="sticky top-0 z-50 bg-bg-primary/80 backdrop-blur-xl border-b border-border-primary">
      <nav class="container-custom py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-lg font-semibold text-text-primary">
            älginventering.se
          </a>
          
          <button
            id="mobile-menu-button"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Öppna huvudmeny</span>
            <svg class="block h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
          
          <div class="hidden md:flex md:items-center md:space-x-8">
            <a href="/metodik" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Metodik</a>
            <a href="/kostnad" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Kostnad</a>
            <a href="/jamfor-metoder" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Jämför</a>
            <div class="relative group">
              <button class="text-sm text-text-secondary hover:text-text-primary transition-colors inline-flex items-center">
                För dig
                <svg class="ml-1 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-48 rounded-lg bg-bg-elevated border border-border-primary opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 shadow-2xl">
                <div class="py-2">
                  <a href="/for/jaktlag" class="block px-4 py-2 text-sm text-text-secondary hover:bg-bg-tertiary hover:text-text-primary transition-colors">Jaktlag</a>
                  <a href="/for/aso" class="block px-4 py-2 text-sm text-text-secondary hover:bg-bg-tertiary hover:text-text-primary transition-colors">ÄSO</a>
                  <a href="/for/afo" class="block px-4 py-2 text-sm text-text-secondary hover:bg-bg-tertiary hover:text-text-primary transition-colors">ÄFO</a>
                  <a href="/for/markagare" class="block px-4 py-2 text-sm text-text-text-secondary hover:bg-bg-tertiary hover:text-text-primary transition-colors">Markägare</a>
                </div>
              </div>
            </div>
            <a href="/faq" class="text-sm text-text-secondary hover:text-text-primary transition-colors">FAQ</a>
            <a href="/kontakt" class="btn-primary text-sm">Boka samtal</a>
          </div>
        </div>
        
        <!-- Mobile menu -->
        <div class="hidden md:hidden mt-4" id="mobile-menu">
          <div class="space-y-1">
            <a href="/metodik" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">Metodik</a>
            <a href="/kostnad" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">Kostnad</a>
            <a href="/jamfor-metoder" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">Jämför</a>
            <a href="/for/jaktlag" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">För jaktlag</a>
            <a href="/for/aso" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">För ÄSO</a>
            <a href="/for/afo" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">För ÄFO</a>
            <a href="/for/markagare" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">För markägare</a>
            <a href="/faq" class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-text-primary hover:bg-bg-elevated transition-colors">FAQ</a>
            <a href="/kontakt" class="block px-3 py-2 rounded-lg text-sm text-white bg-accent-primary hover:bg-accent-hover transition-colors">Boka samtal</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-border-primary mt-32">
      <div class="container-custom py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
          <div>
            <h3 class="text-base font-semibold text-text-primary mb-4">älginventering.se</h3>
            <p class="text-sm text-text-secondary leading-relaxed">
              Drönarkompaniet Norden AB<br />
              Termisk älginventering enligt vetenskaplig metodik
            </p>
            <p class="text-sm text-text-tertiary mt-4">
              Drivs med <a href="https://viltanalys.se" target="_blank" rel="noopener" class="text-text-secondary hover:text-text-primary transition-colors">Viltanalys</a>
            </p>
          </div>
          
          <div>
            <h4 class="text-sm font-medium text-text-primary mb-4">Tjänster</h4>
            <ul class="space-y-2">
              <li><a href="/metodik" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Metodik</a></li>
              <li><a href="/kostnad" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Kostnad</a></li>
              <li><a href="/jamfor-metoder" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Jämför metoder</a></li>
              <li><a href="/case" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Case & Referens</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-sm font-medium text-text-primary mb-4">För dig</h4>
            <ul class="space-y-2">
              <li><a href="/for/jaktlag" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Jaktlag</a></li>
              <li><a href="/for/aso" class="text-sm text-text-secondary hover:text-text-primary transition-colors">ÄSO</a></li>
              <li><a href="/for/afo" class="text-sm text-text-secondary hover:text-text-primary transition-colors">ÄFO</a></li>
              <li><a href="/for/markagare" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Markägare</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-sm font-medium text-text-primary mb-4">Kontakt</h4>
            <ul class="space-y-2">
              <li><a href="tel:+46709780908" class="text-sm text-text-secondary hover:text-text-primary transition-colors">0709-780 908</a></li>
              <li><a href="mailto:info@dronarkompaniet.se" class="text-sm text-text-secondary hover:text-text-primary transition-colors">info@dronarkompaniet.se</a></li>
              <li><a href="https://dronarkompaniet.se" target="_blank" rel="noopener" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Drönarkompaniet.se</a></li>
            </ul>
          </div>
        </div>
        
        <div class="pt-8 border-t border-border-primary text-sm text-center text-text-tertiary">
          <p>&copy; {new Date().getFullYear()} Drönarkompaniet Norden AB</p>
        </div>
      </div>
    </footer>

    <script>
      const button = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      
      button?.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', (!expanded).toString());
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
