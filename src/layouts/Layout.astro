---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og-default.jpg' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="sv_SE" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Älginventering med Termisk Drönare",
        "image": "https://älginventering.se/images/og-default.jpg",
        "description": "Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning. I linje med SLU 2026.",
        "telephone": "+46709780908",
        "url": "https://älginventering.se",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "SE"
        },
        "parentOrganization": {
          "@type": "Organization",
          "name": "Drönarkompaniet Norden AB",
          "url": "https://dronarkompaniet.se"
        },
        "priceRange": "$$",
        "serviceArea": {
          "@type": "Country",
          "name": "Sverige"
        }
      }
    </script>
    
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Älginventering med Drönare",
        "provider": {
          "@type": "LocalBusiness",
          "name": "Drönarkompaniet Norden AB"
        },
        "areaServed": {
          "@type": "Country",
          "name": "Sverige"
        },
        "description": "Provyteinventering av älg med termisk drönare. Täthetsskattning med konfidensintervall enligt vetenskaplig metodik i linje med SLU:s utvärdering 2026."
      }
    </script>
  </head>
  <body>
    <header class="sticky top-0 z-50 bg-paper-50/95 backdrop-blur-sm border-b border-paper-200">
      <nav class="container-custom py-5">
        <div class="flex items-center justify-between">
          <a href="/" class="text-2xl font-display font-bold text-ink-950 tracking-tight">
            Älginventering<span class="text-moss-600">.se</span>
          </a>
          
          <button
            id="mobile-menu-button"
            type="button"
            class="md:hidden inline-flex items-center justify-center p-2 rounded-sm text-charcoal-700 hover:text-ink-900 hover:bg-paper-200 transition-colors"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Öppna huvudmeny</span>
            <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
          
          <div class="hidden md:flex md:items-center md:space-x-8">
            <a href="/metodik" class="text-charcoal-700 hover:text-ink-900 font-medium transition-colors">Metodik</a>
            <a href="/kostnad" class="text-charcoal-700 hover:text-ink-900 font-medium transition-colors">Kostnad</a>
            <a href="/jamfor-metoder" class="text-charcoal-700 hover:text-ink-900 font-medium transition-colors">Jämför</a>
            <div class="relative group">
              <button class="text-charcoal-700 hover:text-ink-900 font-medium transition-colors inline-flex items-center">
                För dig
                <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-48 rounded-sm shadow-xl bg-paper-50 border border-paper-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="py-1">
                  <a href="/for/jaktlag" class="block px-4 py-2 text-sm text-charcoal-700 hover:bg-paper-100 hover:text-ink-900">Jaktlag</a>
                  <a href="/for/aso" class="block px-4 py-2 text-sm text-charcoal-700 hover:bg-paper-100 hover:text-ink-900">ÄSO</a>
                  <a href="/for/afo" class="block px-4 py-2 text-sm text-charcoal-700 hover:bg-paper-100 hover:text-ink-900">ÄFO</a>
                  <a href="/for/markagare" class="block px-4 py-2 text-sm text-charcoal-700 hover:bg-paper-100 hover:text-ink-900">Markägare</a>
                </div>
              </div>
            </div>
            <a href="/faq" class="text-charcoal-700 hover:text-ink-900 font-medium transition-colors">FAQ</a>
            <a href="/kontakt" class="btn-primary text-sm px-6 py-2.5">Boka samtal</a>
          </div>
        </div>
        
        <div class="hidden md:hidden" id="mobile-menu">
          <div class="px-2 pt-2 pb-3 space-y-1">
            <a href="/metodik" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">Metodik</a>
            <a href="/kostnad" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">Kostnad</a>
            <a href="/jamfor-metoder" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">Jämför</a>
            <a href="/for/jaktlag" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">För jaktlag</a>
            <a href="/for/aso" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">För ÄSO</a>
            <a href="/for/afo" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">För ÄFO</a>
            <a href="/for/markagare" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">För markägare</a>
            <a href="/faq" class="block px-3 py-2 rounded-sm text-base font-medium text-charcoal-700 hover:text-ink-900 hover:bg-paper-100">FAQ</a>
            <a href="/kontakt" class="block px-3 py-2 rounded-sm text-base font-medium text-paper-50 bg-ink-900 hover:bg-ink-800">Boka samtal</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="section-dark mt-32">
      <div class="container-custom py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
          <div>
            <h3 class="text-paper-50 font-display font-bold text-xl mb-4">Älginventering.se</h3>
            <p class="text-sm text-paper-300">
              Drönarkompaniet Norden AB<br />
              Termisk älginventering enligt vetenskaplig metodik
            </p>
          </div>
          
          <div>
            <h4 class="text-paper-100 font-semibold mb-4">Tjänster</h4>
            <ul class="space-y-2 text-sm text-paper-300">
              <li><a href="/metodik" class="hover:text-paper-50 transition-colors">Metodik</a></li>
              <li><a href="/kostnad" class="hover:text-paper-50 transition-colors">Kostnad</a></li>
              <li><a href="/jamfor-metoder" class="hover:text-paper-50 transition-colors">Jämför metoder</a></li>
              <li><a href="/case" class="hover:text-paper-50 transition-colors">Case & Referens</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-paper-100 font-semibold mb-4">För dig</h4>
            <ul class="space-y-2 text-sm text-paper-300">
              <li><a href="/for/jaktlag" class="hover:text-paper-50 transition-colors">Jaktlag</a></li>
              <li><a href="/for/aso" class="hover:text-paper-50 transition-colors">ÄSO</a></li>
              <li><a href="/for/afo" class="hover:text-paper-50 transition-colors">ÄFO</a></li>
              <li><a href="/for/markagare" class="hover:text-paper-50 transition-colors">Markägare</a></li>
            </ul>
          </div>
          
          <div>
            <h4 class="text-paper-100 font-semibold mb-4">Kontakt</h4>
            <ul class="space-y-2 text-sm text-paper-300">
              <li><a href="tel:+46709780908" class="hover:text-paper-50 transition-colors">0709-780 908</a></li>
              <li><a href="mailto:info@dronarkompaniet.se" class="hover:text-paper-50 transition-colors">info@dronarkompaniet.se</a></li>
              <li><a href="https://dronarkompaniet.se" target="_blank" rel="noopener" class="hover:text-paper-50 transition-colors">Drönarkompaniet.se</a></li>
            </ul>
          </div>
        </div>
        
        <div class="pt-8 border-t border-charcoal-700 text-sm text-center text-paper-300">
          <p>&copy; {new Date().getFullYear()} Drönarkompaniet Norden AB. Alla rättigheter förbehållna.</p>
        </div>
      </div>
    </footer>

    <script>
      const button = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      
      button?.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', (!expanded).toString());
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
