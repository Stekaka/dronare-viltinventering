---
// Calculator constants per requirements
const SEK_PER_DAY = 8000;
const HA_PER_DAY = 1500;
const DEFAULT_COVERAGE = 30;
const KON_KALV_COVERAGE = 40;
const DEFAULT_TRAVEL = 12000;
---

<div id="pris" style="padding: 110px clamp(20px, 6vw, 64px); background: #2b3324; scroll-margin-top: 90px;">
	<div style="text-align: center; margin-bottom: 52px;">
		<span style="font: 600 12.5px 'Karla', sans-serif; color: #a39a7c; letter-spacing: 0.1em; text-transform: uppercase;">PRISKALKYLATOR</span>
		<h2 style="font: 600 40px 'Spectral', serif; color: #efe8d8; margin: 14px 0 14px;">Räkna ut ett ungefärligt pris</h2>
		<p style="font: 400 15.5px/1.6 'Karla', sans-serif; color: #c9c0a3; max-width: 620px; margin: 0 auto;">
			8 000 kr per flygdag. En dag täcker ca 1 500 hektar med provytor (default 30% täckningsgrad, 40% vid kön/kalv).
		</p>
	</div>
	
	<div style="max-width: 800px; margin: 0 auto; background: rgba(239, 232, 216, 0.05); border: 1px solid rgba(239, 232, 216, 0.2); padding: 48px;">
		<form id="calculator-form">
			<!-- Total area -->
			<div style="margin-bottom: 32px;">
				<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px;">
					<label for="total-area" style="font: 600 13px 'Karla', sans-serif; color: #d8d2bc; letter-spacing: 0.04em; text-transform: uppercase;">
						Fastighetens areal (hektar)
					</label>
					<span id="area-display" style="font: 600 22px 'Spectral', serif; color: #efe8d8;">15 000 ha</span>
				</div>
				<input
					id="total-area"
					type="range"
					min="500"
					max="100000"
					step="500"
					value="15000"
					style="width: 100%; accent-color: #d9b877; margin: 10px 0;"
				/>
				<div style="display: flex; justify-content: space-between; font: 400 11px 'Karla', sans-serif; color: #a39a7c;">
					<span>500 ha</span>
					<span>100 000 ha</span>
				</div>
			</div>

			<!-- Coverage % -->
			<div style="margin-bottom: 32px;">
				<label style="font: 600 13px 'Karla', sans-serif; color: #d8d2bc; letter-spacing: 0.04em; text-transform: uppercase; display: block; margin-bottom: 12px;">
					Täckningsgrad (%)
				</label>
				<div style="display: flex; gap: 12px; flex-wrap: wrap;">
					<input type="number" id="coverage" min="20" max="50" value="30" style="width: 80px; font: 400 15px 'Karla', sans-serif; background: #efe8d8; border: 1px solid #2b3324; padding: 10px 12px; color: #242b1e;" />
					<span style="font: 400 14px 'Karla', sans-serif; color: #c9c0a3; align-self: center;">
						Standard 30%, rekommenderas 40% vid kön/kalv-inventering
					</span>
				</div>
			</div>

			<!-- Kön/kalv toggle -->
			<div style="margin-bottom: 32px;">
				<label style="font: 600 13px 'Karla', sans-serif; color: #d8d2bc; letter-spacing: 0.04em; text-transform: uppercase; display: block; margin-bottom: 12px;">
					Inventering av kön/kalv?
				</label>
				<div style="display: flex; gap: 12px;">
					<button type="button" class="kon-kalv-btn" data-value="false" style="font: 600 13.5px 'Karla', sans-serif; padding: 12px 20px; border: 1.5px solid #d9b877; cursor: pointer; letter-spacing: 0.02em; background: transparent; color: #efe8d8;">
						Nej (endast täthet)
					</button>
					<button type="button" class="kon-kalv-btn active" data-value="true" style="font: 600 13.5px 'Karla', sans-serif; padding: 12px 20px; border: 1.5px solid #d9b877; cursor: pointer; letter-spacing: 0.02em; background: #d9b877; color: #2b3324;">
						Ja (inkl. kön/kalv)
					</button>
				</div>
			</div>

			<!-- Travel mode -->
			<div style="margin-bottom: 36px;">
				<label style="font: 600 13px 'Karla', sans-serif; color: #d8d2bc; letter-spacing: 0.04em; text-transform: uppercase; display: block; margin-bottom: 12px;">
					Resor & boende
				</label>
				<div style="display: flex; flex-direction: column; gap: 8px;">
					<label style="display: flex; align-items: center; gap: 10px; font: 400 14px 'Karla', sans-serif; color: #c9c0a3; cursor: pointer;">
						<input type="radio" name="travel-mode" value="none" checked style="width: 18px; height: 18px; accent-color: #d9b877;" />
						<span>Exkl. resor (visas separat i offert)</span>
					</label>
					<label style="display: flex; align-items: center; gap: 10px; font: 400 14px 'Karla', sans-serif; color: #c9c0a3; cursor: pointer;">
						<input type="radio" name="travel-mode" value="schablon" style="width: 18px; height: 18px; accent-color: #d9b877;" />
						<span>Schablon resor/boende</span>
					</label>
					<div id="travel-amount-container" style="display: none; margin-left: 28px; margin-top: 6px;">
						<input type="number" id="travel-amount" min="0" step="1000" value="12000" style="width: 120px; font: 400 15px 'Karla', sans-serif; background: #efe8d8; border: 1px solid #2b3324; padding: 10px 12px; color: #242b1e;" />
						<span style="font: 400 13px 'Karla', sans-serif; color: #a39a7c; margin-left: 8px;">SEK</span>
					</div>
					<label style="display: flex; align-items: center; gap: 10px; font: 400 14px 'Karla', sans-serif; color: #c9c0a3; cursor: pointer;">
						<input type="radio" name="travel-mode" value="offert" style="width: 18px; height: 18px; accent-color: #d9b877;" />
						<span>Tillkommer i offert</span>
					</label>
				</div>
			</div>

			<!-- Results -->
			<div style="border-top: 1px solid rgba(239, 232, 216, 0.2); padding-top: 32px;">
				<div style="background: rgba(239, 232, 216, 0.08); border: 1px solid rgba(239, 232, 216, 0.25); padding: 28px; margin-bottom: 20px;">
					<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin-bottom: 24px;">
						<div>
							<div style="font: 400 12px 'Karla', sans-serif; color: #a39a7c; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 6px;">
								Inventerad yta
							</div>
							<div id="inventerad-ha" style="font: 600 22px 'Spectral', serif; color: #efe8d8;">4 500 ha</div>
						</div>
						<div>
							<div style="font: 400 12px 'Karla', sans-serif; color: #a39a7c; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 6px;">
								Flygdagar
							</div>
							<div id="days" style="font: 600 22px 'Spectral', serif; color: #efe8d8;">3 dagar</div>
						</div>
						<div>
							<div style="font: 400 12px 'Karla', sans-serif; color: #a39a7c; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 6px;">
								Flygkostnad
							</div>
							<div id="flight-cost" style="font: 600 22px 'Spectral', serif; color: #efe8d8;">24 000 kr</div>
						</div>
					</div>
					<div style="border-top: 1px solid rgba(239, 232, 216, 0.15); padding-top: 20px; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 16px;">
						<div>
							<div style="font: 400 12px 'Karla', sans-serif; color: #a39a7c; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 8px;">
								Totalt pris
							</div>
							<div id="total-price" style="font: 600 44px 'Spectral', serif; color: #efe8d8;">24 000 kr</div>
							<div id="price-detail" style="font: 400 13px 'Karla', sans-serif; color: #c9c0a3; margin-top: 6px;">
								Exkl. moms · Resor visas i offert
							</div>
						</div>
						<div style="text-align: right;">
							<div style="font: 400 12px 'Karla', sans-serif; color: #a39a7c; margin-bottom: 6px;">
								Kostnad per hektar
							</div>
							<div id="kr-per-ha" style="font: 400 18px 'Karla', sans-serif; color: #d8d2bc;">1,60 kr/ha</div>
						</div>
					</div>
				</div>
				<a href="/kontakt" style="display: inline-block; text-decoration: none; background: #d9b877; color: #2b3324; padding: 16px 28px; font: 600 14.5px 'Karla', sans-serif; white-space: nowrap; margin-bottom: 16px;">
					Begär offert
				</a>
				<p style="font: 400 12.5px/1.5 'Karla', sans-serif; color: #8f8768; margin: 0;">
					Uppskattning baserad på schablon — exakt pris och tidsplan bekräftas alltid i offert. Minsta areal ~500 hektar.
				</p>
			</div>
		</form>
	</div>
</div>

<script>
	const SEK_PER_DAY = 8000;
	const HA_PER_DAY = 1500;
	const DEFAULT_COVERAGE = 30;
	const KON_KALV_COVERAGE = 40;

	const areaInput = document.getElementById('total-area') as HTMLInputElement;
	const areaDisplay = document.getElementById('area-display') as HTMLElement;
	const coverageInput = document.getElementById('coverage') as HTMLInputElement;
	const konKalvBtns = document.querySelectorAll('.kon-kalv-btn');
	const travelRadios = document.querySelectorAll('input[name="travel-mode"]') as NodeListOf<HTMLInputElement>;
	const travelAmountContainer = document.getElementById('travel-amount-container') as HTMLElement;
	const travelAmountInput = document.getElementById('travel-amount') as HTMLInputElement;

	const inventeradHa = document.getElementById('inventerad-ha') as HTMLElement;
	const daysEl = document.getElementById('days') as HTMLElement;
	const flightCostEl = document.getElementById('flight-cost') as HTMLElement;
	const totalPriceEl = document.getElementById('total-price') as HTMLElement;
	const priceDetailEl = document.getElementById('price-detail') as HTMLElement;
	const krPerHaEl = document.getElementById('kr-per-ha') as HTMLElement;

	let konKalv = false;

	function calculate() {
		const totalHa = Number(areaInput.value);
		const coverage = Number(coverageInput.value);
		const invHa = Math.round(totalHa * (coverage / 100));
		const days = Math.max(1, Math.ceil(invHa / HA_PER_DAY));
		const flightCost = days * SEK_PER_DAY;

		let travelCost = 0;
		let travelMode = 'none';
		travelRadios.forEach((radio) => {
			if (radio.checked) travelMode = radio.value;
		});

		if (travelMode === 'schablon') {
			travelCost = Number(travelAmountInput.value);
		}

		const totalCost = flightCost + travelCost;
		const krPerHaExcl = totalHa > 0 ? flightCost / totalHa : 0;
		const krPerHaIncl = totalHa > 0 ? totalCost / totalHa : 0;

		areaDisplay.textContent = `${totalHa.toLocaleString('sv-SE')} ha`;
		inventeradHa.textContent = `${invHa.toLocaleString('sv-SE')} ha`;
		daysEl.textContent = `${days} ${days === 1 ? 'dag' : 'dagar'}`;
		flightCostEl.textContent = `${flightCost.toLocaleString('sv-SE')} kr`;
		totalPriceEl.textContent = `${totalCost.toLocaleString('sv-SE')} kr`;
		
		let detailText = 'Exkl. moms';
		if (travelMode === 'schablon') {
			detailText = `Inkl. resor ${travelCost.toLocaleString('sv-SE')} kr · Exkl. moms`;
			krPerHaEl.textContent = `${krPerHaIncl.toFixed(2)} kr/ha (inkl. resor)`;
		} else if (travelMode === 'offert') {
			detailText = 'Exkl. moms · Resor tillkommer';
			krPerHaEl.textContent = `${krPerHaExcl.toFixed(2)} kr/ha (exkl. resor)`;
		} else {
			detailText = 'Exkl. moms · Resor visas i offert';
			krPerHaEl.textContent = `${krPerHaExcl.toFixed(2)} kr/ha (exkl. resor)`;
		}
		priceDetailEl.textContent = detailText;
	}

	areaInput.addEventListener('input', calculate);
	coverageInput.addEventListener('input', calculate);

	konKalvBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const value = (btn as HTMLElement).dataset.value === 'true';
			konKalv = value;
			konKalvBtns.forEach((b) => {
				b.classList.remove('active');
				(b as HTMLElement).style.background = 'transparent';
				(b as HTMLElement).style.color = '#efe8d8';
			});
			btn.classList.add('active');
			(btn as HTMLElement).style.background = '#d9b877';
			(btn as HTMLElement).style.color = '#2b3324';

			if (konKalv) {
				const currentCoverage = Number(coverageInput.value);
				if (currentCoverage < KON_KALV_COVERAGE) {
					coverageInput.value = String(KON_KALV_COVERAGE);
				}
				coverageInput.min = String(KON_KALV_COVERAGE);
			} else {
				coverageInput.min = '20';
			}
			calculate();
		});
	});

	travelRadios.forEach((radio) => {
		radio.addEventListener('change', () => {
			if (radio.value === 'schablon') {
				travelAmountContainer.style.display = 'block';
			} else {
				travelAmountContainer.style.display = 'none';
			}
			calculate();
		});
	});

	travelAmountInput.addEventListener('input', calculate);

	calculate();
</script>

<style>
	.kon-kalv-btn {
		transition: all 0.2s;
	}
	.kon-kalv-btn:hover {
		border-color: #c9973f;
	}
</style>
