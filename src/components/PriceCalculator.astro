---
---

<div class="instrument-panel shadow-2xl">
  <div class="mb-8">
    <h2 class="text-3xl md:text-4xl font-display font-bold text-paper-50 mb-2">Beräkna kostnad</h2>
    <p class="text-paper-300 text-sm">Orientering — offert efter genomgång av ert område</p>
  </div>
  
  <form id="price-calculator" class="space-y-8">
    <!-- Area Input -->
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label for="total-area" class="instrument-label block mb-3">
          Total areal (hektar)
        </label>
        <input
          type="number"
          id="total-area"
          name="totalArea"
          min="500"
          max="50000"
          step="1"
          value="17455"
          class="w-full px-5 py-3.5 bg-charcoal-800 border-2 border-charcoal-600 rounded-sm text-paper-50 text-lg font-semibold focus:outline-none focus:border-moss-600 transition-colors"
          required
        />
        <p class="text-xs text-paper-400 mt-2">Minst 500 ha rekommenderas</p>
      </div>

      <!-- Kön/Kalv Toggle -->
      <div class="flex items-start pt-7">
        <input
          type="checkbox"
          id="gender-calf"
          name="genderCalf"
          class="mt-1.5 h-5 w-5 text-moss-600 focus:ring-moss-600 bg-charcoal-800 border-charcoal-600 rounded"
        />
        <label for="gender-calf" class="ml-4 flex-1">
          <span class="instrument-label block mb-1">Även könskvot / kalv</span>
          <span class="text-xs text-paper-400">Kräver generellt större stickprov (SLU)</span>
        </label>
      </div>
    </div>

    <!-- Coverage Selection -->
    <div>
      <label class="instrument-label block mb-4">
        Täckningsgrad
      </label>
      <div class="grid grid-cols-4 gap-3 mb-3">
        <button
          type="button"
          class="coverage-btn px-4 py-3 border-2 border-charcoal-600 rounded-sm text-sm font-semibold text-paper-300 hover:border-moss-600 hover:text-paper-50 focus:outline-none focus:ring-2 focus:ring-moss-600 transition-all"
          data-coverage="20"
        >
          20%
        </button>
        <button
          type="button"
          class="coverage-btn px-4 py-3 border-2 border-moss-600 bg-moss-600/10 rounded-sm text-sm font-semibold text-moss-500 focus:outline-none focus:ring-2 focus:ring-moss-600 transition-all"
          data-coverage="30"
        >
          30% <span class="text-[10px]">REK</span>
        </button>
        <button
          type="button"
          class="coverage-btn px-4 py-3 border-2 border-charcoal-600 rounded-sm text-sm font-semibold text-paper-300 hover:border-moss-600 hover:text-paper-50 focus:outline-none focus:ring-2 focus:ring-moss-600 transition-all"
          data-coverage="40"
        >
          40%
        </button>
        <button
          type="button"
          class="coverage-btn px-4 py-3 border-2 border-charcoal-600 rounded-sm text-sm font-semibold text-paper-300 hover:border-moss-600 hover:text-paper-50 focus:outline-none focus:ring-2 focus:ring-moss-600 transition-all"
          data-coverage="50"
        >
          50%
        </button>
      </div>
      <input type="hidden" id="coverage-value" name="coverage" value="30" />
      <p id="coverage-helper" class="text-xs text-paper-400">30 % räcker ofta för täthet. Högre täckning vid stark aggregation eller för kön/kalv med bättre precision.</p>
    </div>

    <!-- Travel/Lodging Mode -->
    <div>
      <label class="instrument-label block mb-4">
        Resor och boende
      </label>
      <div class="space-y-3">
        <label class="flex items-start p-4 border-2 border-moss-600 bg-moss-600/5 rounded-sm cursor-pointer transition-all">
          <input
            type="radio"
            name="travelMode"
            value="excl"
            checked
            class="mt-1 h-4 w-4 text-moss-600 focus:ring-moss-600 bg-charcoal-800 border-charcoal-600"
          />
          <span class="ml-3 flex-1">
            <span class="block text-sm font-semibold text-paper-100">Exkl. resor</span>
            <span class="block text-xs text-paper-400 mt-0.5">Endast flygkostnad</span>
          </span>
        </label>

        <label class="flex items-start p-4 border-2 border-charcoal-600 rounded-sm cursor-pointer hover:border-moss-600/50 transition-all">
          <input
            type="radio"
            name="travelMode"
            value="schablon"
            class="mt-1 h-4 w-4 text-moss-600 focus:ring-moss-600 bg-charcoal-800 border-charcoal-600"
          />
          <span class="ml-3 flex-1">
            <span class="block text-sm font-semibold text-paper-100 mb-2">Schablon resor/boende</span>
            <input
              type="number"
              id="travel-amount"
              name="travelAmount"
              min="0"
              step="1000"
              value="12000"
              disabled
              class="w-full px-3 py-2 text-sm bg-charcoal-900 border border-charcoal-600 rounded-sm text-paper-200 disabled:opacity-50 focus:outline-none focus:border-moss-600"
            />
            <span class="block text-xs text-paper-400 mt-1">Schablon, ej bindande offert</span>
          </span>
        </label>

        <label class="flex items-start p-4 border-2 border-charcoal-600 rounded-sm cursor-pointer hover:border-moss-600/50 transition-all">
          <input
            type="radio"
            name="travelMode"
            value="offert"
            class="mt-1 h-4 w-4 text-moss-600 focus:ring-moss-600 bg-charcoal-800 border-charcoal-600"
          />
          <span class="ml-3">
            <span class="block text-sm font-semibold text-paper-100">Tillkommer i offert</span>
            <span class="block text-xs text-paper-400 mt-0.5">Resor och boende tillkommer efter plats</span>
          </span>
        </label>
      </div>
    </div>

    <!-- Results - Instrument Readouts -->
    <div class="mt-10 pt-8 border-t-2 border-charcoal-700">
      <div class="grid md:grid-cols-2 gap-8 mb-8">
        <div>
          <div class="instrument-label mb-2">Inventerad areal</div>
          <div id="result-inventerad" class="instrument-readout">6 982 ha</div>
        </div>
        <div>
          <div class="instrument-label mb-2">Beräknade flygdagar</div>
          <div id="result-days" class="instrument-readout">5 dagar</div>
        </div>
      </div>

      <div class="bg-charcoal-800/50 border-2 border-charcoal-700 rounded-sm p-6 space-y-4">
        <div class="flex justify-between items-baseline">
          <span class="text-paper-300 text-sm">Flygkostnad</span>
          <span id="result-flight" class="text-2xl font-display font-bold text-paper-50">40 000 kr</span>
        </div>
        <div id="result-travel-row" class="hidden flex justify-between items-baseline">
          <span class="text-paper-300 text-sm">Resor/boende (schablon)</span>
          <span id="result-travel" class="text-xl font-display font-semibold text-paper-100">12 000 kr</span>
        </div>
        <div class="pt-4 border-t border-charcoal-700">
          <div class="flex justify-between items-baseline">
            <span class="text-paper-300 text-sm">Kr per hektar (exkl. resor)</span>
            <span id="result-kr-ha-excl" class="text-lg font-display font-semibold text-moss-500">2,29 kr/ha</span>
          </div>
        </div>
        <div id="result-total-row" class="hidden pt-4 border-t border-charcoal-700">
          <div class="flex justify-between items-baseline mb-2">
            <span class="font-semibold text-paper-100">Total inkl. schablon</span>
            <span id="result-total" class="text-3xl font-display font-bold text-paper-50">52 000 kr</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-paper-400 text-xs">Kr per hektar (inkl. schablon)</span>
            <span id="result-kr-ha-incl" class="text-sm font-semibold text-moss-500">2,98 kr/ha</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="p-4 bg-thermal-600/10 border-l-4 border-thermal-600 rounded-sm">
      <p class="text-xs text-paper-200 leading-relaxed">
        <strong class="text-thermal-400">OBS:</strong> Kalkylen är en orientering utifrån 8 000 kr/flygdag och ca 1 500 ha inventerade provytor per dag. 
        Resor och boende tillkommer. Offert efter genomgång av ert område.
      </p>
    </div>

    <!-- Explanation -->
    <div class="text-xs text-paper-400 leading-relaxed">
      <strong class="text-paper-300">Beräkningen:</strong> Den inventerade arealen (total × täckning) delas med 
      ca 1 500 ha provytor per flygdag. Dagar rundas alltid uppåt. Priset per hektar beräknas på 
      <em>total areal</em>, inte inventerad areal.
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center">
      <a href="/kontakt" class="btn-primary inline-flex items-center text-lg px-10 py-4.5">
        Boka 15 min — offert skräddarsydd för ert område
        <svg class="ml-2 -mr-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </form>
</div>

<script>
  const SEK_PER_DAY = 8000;
  const HA_PER_DAY = 1500;
  const MIN_AREA = 500;

  let currentCoverage = 30;
  let isGenderCalf = false;

  const totalAreaInput = document.getElementById('total-area') as HTMLInputElement;
  const genderCalfCheckbox = document.getElementById('gender-calf') as HTMLInputElement;
  const coverageButtons = document.querySelectorAll('.coverage-btn');
  const coverageValue = document.getElementById('coverage-value') as HTMLInputElement;
  const travelModeRadios = document.querySelectorAll('input[name="travelMode"]') as NodeListOf<HTMLInputElement>;
  const travelAmountInput = document.getElementById('travel-amount') as HTMLInputElement;
  
  const resultInventerad = document.getElementById('result-inventerad') as HTMLSpanElement;
  const resultDays = document.getElementById('result-days') as HTMLSpanElement;
  const resultFlight = document.getElementById('result-flight') as HTMLSpanElement;
  const resultTravelRow = document.getElementById('result-travel-row') as HTMLDivElement;
  const resultTravel = document.getElementById('result-travel') as HTMLSpanElement;
  const resultKrHaExcl = document.getElementById('result-kr-ha-excl') as HTMLSpanElement;
  const resultTotalRow = document.getElementById('result-total-row') as HTMLDivElement;
  const resultTotal = document.getElementById('result-total') as HTMLSpanElement;
  const resultKrHaIncl = document.getElementById('result-kr-ha-incl') as HTMLSpanElement;

  function calculate() {
    const totalHa = parseFloat(totalAreaInput.value) || 0;
    
    if (totalHa < MIN_AREA) {
      resultInventerad.textContent = 'Kontakta oss';
      resultDays.textContent = '—';
      resultFlight.textContent = '—';
      resultKrHaExcl.textContent = '—';
      return;
    }

    const inventeradHa = totalHa * (currentCoverage / 100);
    const daysRaw = inventeradHa / HA_PER_DAY;
    const days = Math.ceil(daysRaw);
    const flightCost = days * SEK_PER_DAY;
    const krPerHaExcl = flightCost / totalHa;
    
    resultInventerad.textContent = `${Math.round(inventeradHa).toLocaleString('sv-SE')} ha`;
    resultDays.textContent = `${days} ${days === 1 ? 'dag' : 'dagar'}`;
    resultFlight.textContent = `${flightCost.toLocaleString('sv-SE')} kr`;
    resultKrHaExcl.textContent = `${krPerHaExcl.toFixed(2)} kr/ha`;
    
    const travelMode = document.querySelector('input[name="travelMode"]:checked') as HTMLInputElement;
    if (travelMode?.value === 'schablon') {
      const travelAmount = parseFloat(travelAmountInput.value) || 0;
      const totalIncl = flightCost + travelAmount;
      const krPerHaIncl = totalIncl / totalHa;
      
      resultTravelRow.classList.remove('hidden');
      resultTotalRow.classList.remove('hidden');
      resultTravel.textContent = `${travelAmount.toLocaleString('sv-SE')} kr`;
      resultTotal.textContent = `${totalIncl.toLocaleString('sv-SE')} kr`;
      resultKrHaIncl.textContent = `${krPerHaIncl.toFixed(2)} kr/ha`;
    } else {
      resultTravelRow.classList.add('hidden');
      resultTotalRow.classList.add('hidden');
    }
  }

  coverageButtons.forEach(button => {
    button.addEventListener('click', () => {
      const coverage = parseInt((button as HTMLElement).dataset.coverage || '30');
      
      if (isGenderCalf && coverage < 40) {
        return;
      }
      
      currentCoverage = coverage;
      coverageValue.value = coverage.toString();
      
      coverageButtons.forEach(btn => {
        btn.classList.remove('border-moss-600', 'bg-moss-600/10', 'text-moss-500');
        btn.classList.add('border-charcoal-600', 'text-paper-300');
      });
      button.classList.remove('border-charcoal-600', 'text-paper-300');
      button.classList.add('border-moss-600', 'bg-moss-600/10', 'text-moss-500');
      
      calculate();
    });
  });

  genderCalfCheckbox.addEventListener('change', () => {
    isGenderCalf = genderCalfCheckbox.checked;
    
    if (isGenderCalf && currentCoverage < 40) {
      const button40 = Array.from(coverageButtons).find(btn => 
        (btn as HTMLElement).dataset.coverage === '40'
      ) as HTMLElement;
      button40?.click();
    }
    
    coverageButtons.forEach(btn => {
      const coverage = parseInt((btn as HTMLElement).dataset.coverage || '30');
      if (coverage < 40) {
        if (isGenderCalf) {
          (btn as HTMLButtonElement).disabled = true;
          btn.classList.add('opacity-30', 'cursor-not-allowed');
        } else {
          (btn as HTMLButtonElement).disabled = false;
          btn.classList.remove('opacity-30', 'cursor-not-allowed');
        }
      }
    });
  });

  travelModeRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      const label = radio.closest('label');
      document.querySelectorAll('input[name="travelMode"]').forEach(r => {
        r.closest('label')?.classList.remove('border-moss-600', 'bg-moss-600/5');
        r.closest('label')?.classList.add('border-charcoal-600');
      });
      label?.classList.remove('border-charcoal-600');
      label?.classList.add('border-moss-600', 'bg-moss-600/5');
      
      if (radio.value === 'schablon') {
        travelAmountInput.disabled = false;
        travelAmountInput.classList.remove('opacity-50');
      } else {
        travelAmountInput.disabled = true;
        travelAmountInput.classList.add('opacity-50');
      }
      
      calculate();
    });
  });

  totalAreaInput.addEventListener('input', calculate);
  travelAmountInput.addEventListener('input', calculate);

  calculate();
</script>
