---
---

<div class="bg-bg-tertiary border border-border-primary rounded-lg p-8">
  <form id="price-calculator" class="space-y-8">
    <!-- Area + Gender/Calf -->
    <div class="grid md:grid-cols-2 gap-6">
      <div>
        <label for="total-area" class="eyebrow block mb-3">
          Total areal (hektar)
        </label>
        <input
          type="number"
          id="total-area"
          name="totalArea"
          min="500"
          max="50000"
          step="1"
          value="17455"
          class="w-full px-4 py-3 bg-bg-secondary border border-border-primary rounded-lg text-text-primary focus:outline-none focus:border-border-secondary transition-colors"
          required
        />
        <p class="text-xs text-text-tertiary mt-2">Minst 500 ha rekommenderas</p>
      </div>

      <div class="flex items-start pt-8">
        <input
          type="checkbox"
          id="gender-calf"
          name="genderCalf"
          class="mt-1 h-4 w-4 text-accent-primary focus:ring-accent-primary bg-bg-secondary border-border-primary rounded"
        />
        <label for="gender-calf" class="ml-3">
          <span class="block text-sm font-medium text-text-primary">Även könskvot / kalv</span>
          <span class="block text-xs text-text-secondary mt-1">Kräver högre täckning (SLU)</span>
        </label>
      </div>
    </div>

    <!-- Coverage -->
    <div>
      <label class="eyebrow block mb-3">Täckningsgrad</label>
      <div class="grid grid-cols-4 gap-3 mb-3">
        {['20', '30', '40', '50'].map((coverage, idx) => (
          <button
            type="button"
            class={`coverage-btn px-4 py-3 border rounded-lg text-sm font-medium transition-all focus:outline-none ${idx === 1 ? 'border-accent-primary bg-accent-muted text-accent-primary' : 'border-border-primary text-text-secondary hover:border-border-secondary'}`}
            data-coverage={coverage}
          >
            {coverage}% {idx === 1 && <span class="text-xs">REK</span>}
          </button>
        ))}
      </div>
      <input type="hidden" id="coverage-value" name="coverage" value="30" />
      <p id="coverage-helper" class="text-xs text-text-tertiary">30 % räcker ofta för täthet. Högre täckning vid stark aggregation eller för kön/kalv.</p>
    </div>

    <!-- Travel modes -->
    <div>
      <label class="eyebrow block mb-3">Resor och boende</label>
      <div class="space-y-3">
        {[
          { value: 'excl', title: 'Exkl. resor', desc: 'Endast flygkostnad', checked: true },
          { value: 'schablon', title: 'Schablon resor/boende', desc: null, checked: false },
          { value: 'offert', title: 'Tillkommer i offert', desc: 'Resor och boende tillkommer efter plats', checked: false }
        ].map(mode => (
          <label class={`flex items-start p-4 border rounded-lg cursor-pointer transition-colors ${mode.checked ? 'border-accent-primary bg-accent-muted' : 'border-border-primary hover:border-border-secondary'}`}>
            <input
              type="radio"
              name="travelMode"
              value={mode.value}
              checked={mode.checked}
              class="mt-1 h-4 w-4 text-accent-primary focus:ring-accent-primary bg-bg-secondary border-border-primary"
            />
            <span class="ml-3 flex-1">
              <span class="block text-sm font-medium text-text-primary">{mode.title}</span>
              {mode.desc && <span class="block text-xs text-text-secondary mt-1">{mode.desc}</span>}
              {mode.value === 'schablon' && (
                <input
                  type="number"
                  id="travel-amount"
                  name="travelAmount"
                  min="0"
                  step="1000"
                  value="12000"
                  disabled
                  class="mt-2 w-full px-3 py-2 text-sm bg-bg-secondary border border-border-primary rounded-lg text-text-primary disabled:opacity-50 focus:outline-none focus:border-border-secondary"
                />
              )}
            </span>
          </label>
        ))}
      </div>
    </div>

    <!-- Results -->
    <div class="pt-8 border-t border-border-primary">
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <div>
          <div class="eyebrow mb-2">Inventerad areal</div>
          <div id="result-inventerad" class="text-3xl font-semibold text-text-primary">6 982 ha</div>
        </div>
        <div>
          <div class="eyebrow mb-2">Beräknade flygdagar</div>
          <div id="result-days" class="text-3xl font-semibold text-text-primary">5 dagar</div>
        </div>
      </div>

      <div class="bg-bg-elevated border border-border-primary rounded-lg p-6 space-y-3">
        <div class="flex justify-between items-baseline">
          <span class="text-sm text-text-secondary">Flygkostnad</span>
          <span id="result-flight" class="text-xl font-semibold text-text-primary">40 000 kr</span>
        </div>
        <div id="result-travel-row" class="hidden flex justify-between items-baseline">
          <span class="text-sm text-text-secondary">Resor/boende (schablon)</span>
          <span id="result-travel" class="text-lg font-semibold text-text-primary">12 000 kr</span>
        </div>
        <div class="pt-3 border-t border-border-primary">
          <div class="flex justify-between items-baseline">
            <span class="text-sm text-text-secondary">Kr per hektar (exkl. resor)</span>
            <span id="result-kr-ha-excl" class="text-lg font-semibold text-accent-primary">2,29 kr/ha</span>
          </div>
        </div>
        <div id="result-total-row" class="hidden pt-3 border-t border-border-primary">
          <div class="flex justify-between items-baseline mb-2">
            <span class="font-medium text-text-primary">Total inkl. schablon</span>
            <span id="result-total" class="text-2xl font-semibold text-text-primary">52 000 kr</span>
          </div>
          <div class="flex justify-between items-baseline">
            <span class="text-xs text-text-tertiary">Kr per hektar (inkl. schablon)</span>
            <span id="result-kr-ha-incl" class="text-sm font-semibold text-accent-primary">2,98 kr/ha</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="p-4 bg-accent-muted border border-accent-primary/20 rounded-lg">
      <p class="text-xs text-text-secondary leading-relaxed">
        <strong class="text-text-primary">OBS:</strong> Kalkylen är en orientering utifrån 8 000 kr/flygdag och ca 1 500 ha provytor per dag. 
        Resor och boende tillkommer. Offert efter genomgång.
      </p>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <a href="/kontakt" class="btn-primary inline-flex items-center px-8 py-3">
        Boka 15 min — få skräddarsydd offert
        <svg class="ml-2 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </form>
</div>

<script>
  const SEK_PER_DAY = 8000;
  const HA_PER_DAY = 1500;
  const MIN_AREA = 500;

  let currentCoverage = 30;
  let isGenderCalf = false;

  const totalAreaInput = document.getElementById('total-area') as HTMLInputElement;
  const genderCalfCheckbox = document.getElementById('gender-calf') as HTMLInputElement;
  const coverageButtons = document.querySelectorAll('.coverage-btn');
  const coverageValue = document.getElementById('coverage-value') as HTMLInputElement;
  const travelModeRadios = document.querySelectorAll('input[name="travelMode"]') as NodeListOf<HTMLInputElement>;
  const travelAmountInput = document.getElementById('travel-amount') as HTMLInputElement;
  
  const resultInventerad = document.getElementById('result-inventerad') as HTMLSpanElement;
  const resultDays = document.getElementById('result-days') as HTMLSpanElement;
  const resultFlight = document.getElementById('result-flight') as HTMLSpanElement;
  const resultTravelRow = document.getElementById('result-travel-row') as HTMLDivElement;
  const resultTravel = document.getElementById('result-travel') as HTMLSpanElement;
  const resultKrHaExcl = document.getElementById('result-kr-ha-excl') as HTMLSpanElement;
  const resultTotalRow = document.getElementById('result-total-row') as HTMLDivElement;
  const resultTotal = document.getElementById('result-total') as HTMLSpanElement;
  const resultKrHaIncl = document.getElementById('result-kr-ha-incl') as HTMLSpanElement;

  function calculate() {
    const totalHa = parseFloat(totalAreaInput.value) || 0;
    
    if (totalHa < MIN_AREA) {
      resultInventerad.textContent = 'Kontakta oss';
      resultDays.textContent = '—';
      resultFlight.textContent = '—';
      resultKrHaExcl.textContent = '—';
      return;
    }

    const inventeradHa = totalHa * (currentCoverage / 100);
    const daysRaw = inventeradHa / HA_PER_DAY;
    const days = Math.ceil(daysRaw);
    const flightCost = days * SEK_PER_DAY;
    const krPerHaExcl = flightCost / totalHa;
    
    resultInventerad.textContent = `${Math.round(inventeradHa).toLocaleString('sv-SE')} ha`;
    resultDays.textContent = `${days} ${days === 1 ? 'dag' : 'dagar'}`;
    resultFlight.textContent = `${flightCost.toLocaleString('sv-SE')} kr`;
    resultKrHaExcl.textContent = `${krPerHaExcl.toFixed(2)} kr/ha`;
    
    const travelMode = document.querySelector('input[name="travelMode"]:checked') as HTMLInputElement;
    if (travelMode?.value === 'schablon') {
      const travelAmount = parseFloat(travelAmountInput.value) || 0;
      const totalIncl = flightCost + travelAmount;
      const krPerHaIncl = totalIncl / totalHa;
      
      resultTravelRow.classList.remove('hidden');
      resultTotalRow.classList.remove('hidden');
      resultTravel.textContent = `${travelAmount.toLocaleString('sv-SE')} kr`;
      resultTotal.textContent = `${totalIncl.toLocaleString('sv-SE')} kr`;
      resultKrHaIncl.textContent = `${krPerHaIncl.toFixed(2)} kr/ha`;
    } else {
      resultTravelRow.classList.add('hidden');
      resultTotalRow.classList.add('hidden');
    }
  }

  coverageButtons.forEach(button => {
    button.addEventListener('click', () => {
      const coverage = parseInt((button as HTMLElement).dataset.coverage || '30');
      if (isGenderCalf && coverage < 40) return;
      
      currentCoverage = coverage;
      coverageValue.value = coverage.toString();
      
      coverageButtons.forEach(btn => {
        btn.classList.remove('border-accent-primary', 'bg-accent-muted', 'text-accent-primary');
        btn.classList.add('border-border-primary', 'text-text-secondary');
      });
      button.classList.remove('border-border-primary', 'text-text-secondary');
      button.classList.add('border-accent-primary', 'bg-accent-muted', 'text-accent-primary');
      
      calculate();
    });
  });

  genderCalfCheckbox.addEventListener('change', () => {
    isGenderCalf = genderCalfCheckbox.checked;
    if (isGenderCalf && currentCoverage < 40) {
      const button40 = Array.from(coverageButtons).find(btn => 
        (btn as HTMLElement).dataset.coverage === '40'
      ) as HTMLElement;
      button40?.click();
    }
    coverageButtons.forEach(btn => {
      const coverage = parseInt((btn as HTMLElement).dataset.coverage || '30');
      if (coverage < 40) {
        (btn as HTMLButtonElement).disabled = isGenderCalf;
        btn.classList.toggle('opacity-30', isGenderCalf);
        btn.classList.toggle('cursor-not-allowed', isGenderCalf);
      }
    });
  });

  travelModeRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      const label = radio.closest('label');
      document.querySelectorAll('input[name="travelMode"]').forEach(r => {
        r.closest('label')?.classList.remove('border-accent-primary', 'bg-accent-muted');
        r.closest('label')?.classList.add('border-border-primary');
      });
      label?.classList.remove('border-border-primary');
      label?.classList.add('border-accent-primary', 'bg-accent-muted');
      
      travelAmountInput.disabled = radio.value !== 'schablon';
      calculate();
    });
  });

  totalAreaInput.addEventListener('input', calculate);
  travelAmountInput.addEventListener('input', calculate);
  calculate();
</script>
