---
interface Props {
	eyebrow?: string;
	posterSrc: string;
	posterAlt: string;
	videoMp4?: string;
	videoWebm?: string;
	ctaHref: string;
	ctaLabel: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	trustLine?: string;
}

const {
	eyebrow,
	posterSrc,
	posterAlt,
	videoMp4,
	videoWebm,
	ctaHref,
	ctaLabel,
	secondaryHref,
	secondaryLabel,
	trustLine,
} = Astro.props;
---

<div class="hero-media">
	<div class="hero-media-bg">
		<img src={posterSrc} alt={posterAlt} class="hero-media-img" />
		{videoMp4 && (
			<video
				class="hero-video"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster={posterSrc}
				aria-hidden="true"
			>
				<source src={videoMp4} type="video/mp4" />
				{videoWebm && <source src={videoWebm} type="video/webm" />}
			</video>
		)}
		<div class="hero-media-overlay"></div>
	</div>

	<div class="hero-media-content">
		<div class="container-site">
			{eyebrow && <span class="eyebrow mb-4 block">{eyebrow}</span>}
			<h1 class="hero-title">
				<slot />
			</h1>
			<div class="hero-actions">
				<a href={ctaHref} class="btn-primary">{ctaLabel}</a>
				{secondaryLabel && secondaryHref && (
					<a href={secondaryHref} class="btn-secondary">{secondaryLabel}</a>
				)}
			</div>
			{trustLine && (
				<div class="hero-trust">
					<span class="hero-trust-dot"></span>
					<p class="hero-trust-text">{trustLine}</p>
				</div>
			)}
		</div>
	</div>
</div>

<style>
	.hero-media {
		position: relative;
		min-height: 700px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #0a0a0a;
	}

	.hero-media-bg {
		position: absolute;
		inset: 0;
	}

	.hero-media-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: brightness(0.5) saturate(0.9);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: brightness(0.5) saturate(0.9);
	}

	.hero-media-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(10, 10, 10, 0.4) 0%,
			rgba(10, 10, 10, 0.6) 30%,
			rgba(10, 10, 10, 0.85) 60%,
			rgba(10, 10, 10, 0.95) 100%
		);
	}

	.hero-media-content {
		position: relative;
		flex: 1;
		display: flex;
		align-items: flex-end;
		padding: 40px 0 60px;
	}

	.hero-title {
		font-size: clamp(32px, 8vw, 64px);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: #F0F0F0;
		max-width: 20ch;
		margin: 0 0 32px;
		font-weight: 600;
	}

	.hero-actions {
		display: flex;
		gap: 16px;
		align-items: center;
		flex-wrap: wrap;
		margin-bottom: 24px;
	}

	.hero-trust {
		display: flex;
		align-items: center;
		gap: 12px;
		padding-top: 20px;
		border-top: 1px solid rgba(240, 240, 240, 0.15);
		max-width: 640px;
	}

	.hero-trust-dot {
		width: 6px;
		height: 6px;
		background: #F0F0F0;
		border-radius: 50%;
		flex: none;
	}

	.hero-trust-text {
		font-size: 14px;
		line-height: 1.6;
		color: rgba(240, 240, 240, 0.7);
		margin: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-video {
			display: none;
		}
	}
</style>
