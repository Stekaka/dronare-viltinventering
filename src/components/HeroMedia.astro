---
interface Props {
	eyebrow?: string;
	posterSrc: string;
	posterAlt: string;
	videoMp4?: string;
	videoWebm?: string;
	ctaHref: string;
	ctaLabel: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	trustLine?: string;
}

const {
	eyebrow,
	posterSrc,
	posterAlt,
	videoMp4,
	videoWebm,
	ctaHref,
	ctaLabel,
	secondaryHref,
	secondaryLabel,
	trustLine,
} = Astro.props;
---

<div class="hero-media">
	<div class="hero-media-bg">
		<img src={posterSrc} alt={posterAlt} class="hero-media-img" />
		{videoMp4 && (
			<video
				class="hero-video"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster={posterSrc}
				aria-hidden="true"
			>
				<source src={videoMp4} type="video/mp4" />
				{videoWebm && <source src={videoWebm} type="video/webm" />}
			</video>
		)}
		<div class="hero-media-overlay"></div>
	</div>

	<div class="hero-media-content">
		<div class="container-site">
			{eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
			<h1 class="hero-title">
				<slot />
			</h1>
			<div class="hero-actions">
				<a href={ctaHref} class="btn-primary">{ctaLabel}</a>
				{secondaryLabel && secondaryHref && (
					<a href={secondaryHref} class="btn-secondary">{secondaryLabel}</a>
				)}
			</div>
			{trustLine && (
				<div class="hero-trust">
					<span class="hero-trust-dot"></span>
					<p class="hero-trust-text">{trustLine}</p>
				</div>
			)}
		</div>
	</div>
</div>

<style>
	.hero-media {
		position: relative;
		min-height: 700px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #12160f;
	}

	.hero-media-bg {
		position: absolute;
		inset: 0;
	}

	.hero-media-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		filter: brightness(0.68) saturate(0.92);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: brightness(0.68) saturate(0.92);
	}

	.hero-media-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(8, 10, 6, 0.35) 0%,
			rgba(8, 10, 6, 0.4) 30%,
			rgba(8, 10, 6, 0.78) 52%,
			rgba(8, 10, 6, 0.96) 72%,
			rgba(8, 10, 6, 0.97) 100%
		);
	}

	.hero-media-content {
		position: relative;
		flex: 1;
		display: flex;
		align-items: flex-end;
		padding: 40px 0;
	}

	.hero-eyebrow {
		font: 600 12px 'Karla', sans-serif;
		color: #e0d6b0;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		display: block;
		margin-bottom: 20px;
	}

	.hero-title {
		font: 600 clamp(32px, 9vw, 52px) / 1.14 'Spectral', serif;
		color: #faf6ea;
		max-width: 16ch;
		margin: 0 0 22px;
	}

	.hero-actions {
		display: flex;
		gap: 16px;
		align-items: center;
		flex-wrap: wrap;
	}

	.hero-trust {
		display: flex;
		align-items: center;
		gap: 10px;
		padding-top: 16px;
		margin-top: 24px;
		border-top: 1px solid rgba(239, 232, 216, 0.22);
		max-width: 640px;
	}

	.hero-trust-dot {
		width: 6px;
		height: 6px;
		background: #c9973f;
		border-radius: 50%;
		flex: none;
	}

	.hero-trust-text {
		font: 400 13.5px 'Karla', sans-serif;
		color: #c9c0a3;
		margin: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-video {
			display: none;
		}
	}
</style>
