---
import Layout from '../layouts/Layout.astro';
import PriceCalculator from '../components/PriceCalculator.astro';

const title = 'Kostnad för Älginventering — Beräkna Pris | Älginventering.se';
const description = 'Beräkna kostnad för älginventering med termisk drönare. Transparent prissättning baserad på areal och täckningsgrad. Ca 8 000 kr/flygdag och 1 500 ha provytor per dag.';
---

<Layout title={title} description={description}>
  <section class="section-dark py-20 md:py-28">
    <div class="container-custom">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-paper-50 mb-6">Vad kostar älginventering?</h1>
      <p class="text-xl text-paper-200 max-w-3xl leading-relaxed">
        Transparent prissättning baserad på areal, täckningsgrad och antal flygdagar. 
        Offert efter genomgång av ert specifika område.
      </p>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-paper-100">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <PriceCalculator />
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-paper-50">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-ink-950 mb-12">Så fungerar prissättningen</h2>
        
        <div class="grid md:grid-cols-2 gap-8 mb-16">
          <div class="card-elevated p-8">
            <h3 class="text-2xl font-display font-bold text-ink-900 mb-4">Grundpris per flygdag</h3>
            <div class="flex items-baseline mb-4">
              <span class="text-5xl font-display font-bold text-moss-700">8 000</span>
              <span class="text-xl text-charcoal-600 ml-2">kr/dag</span>
            </div>
            <p class="text-charcoal-600 mb-4 leading-relaxed">
              Priset är orienterande och inkluderar flygning, termisk + optisk utrustning, manuell artkontroll, 
              dataanalys och rapport med konfidensintervall.
            </p>
            <p class="text-sm text-charcoal-500">
              <strong>Inkluderar:</strong> Planering · Flygning · Termisk + optisk utrustning · GPS-loggning · 
              Manuell artkontroll · Täthetsskattning med konfidensintervall · Karta · Bildbevis · Rapport
            </p>
          </div>

          <div class="card-elevated p-8">
            <h3 class="text-2xl font-display font-bold text-ink-900 mb-4">Kapacitet per dag</h3>
            <div class="flex items-baseline mb-4">
              <span class="text-5xl font-display font-bold text-moss-700">~1 500</span>
              <span class="text-xl text-charcoal-600 ml-2">ha provytor/dag</span>
            </div>
            <p class="text-charcoal-600 mb-4 leading-relaxed">
              Kapaciteten varierar beroende på terräng, väder och täckningsgrad. I optimala förhållanden (kallt, molnigt, vinter) 
              kan vi inventera upp till ca 1 500 ha provytor per dag.
            </p>
            <p class="text-sm text-charcoal-500">
              <strong>Påverkar kapacitet:</strong> Väder (sol vs molnigt) · Temperatur · Terräng · Vegetation · 
              Tillgänglighet · Täckningsgrad
            </p>
          </div>
        </div>

        <div class="card-elevated p-8 mb-16 bg-gradient-to-br from-moss-700 via-moss-600 to-moss-700 text-paper-50">
          <h2 class="text-3xl font-display font-bold mb-8">Exempel: 17 455 ha @ 40% täckning</h2>
          
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div>
              <div class="text-sm font-semibold mb-1 text-paper-200">Total areal</div>
              <div class="text-3xl font-display font-bold">17 455 ha</div>
            </div>
            <div>
              <div class="text-sm font-semibold mb-1 text-paper-200">Täckningsgrad</div>
              <div class="text-3xl font-display font-bold">40 %</div>
            </div>
          </div>
          
          <div class="border-t-2 border-moss-500 pt-6 mb-6">
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-paper-100">Inventerad areal (17455 × 0,40):</span>
                <span class="font-semibold">≈ 6 982 ha</span>
              </div>
              <div class="flex justify-between">
                <span class="text-paper-100">Dagar (6982 / 1500, avrundat uppåt):</span>
                <span class="font-semibold">5 dagar</span>
              </div>
              <div class="flex justify-between">
                <span class="text-paper-100">Flygkostnad (5 × 8 000):</span>
                <span class="font-semibold">40 000 kr</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-paper-200">Kr/ha exkl. resor (40000 / 17455):</span>
                <span class="font-semibold">≈ 2,29 kr/ha</span>
              </div>
            </div>
          </div>

          <div class="border-t-2 border-moss-500 pt-6">
            <div class="text-sm font-semibold text-paper-200 mb-2">Med schablon resor/boende +12 000 kr:</div>
            <div class="space-y-2">
              <div class="flex justify-between items-baseline">
                <span>Total inkl. schablon:</span>
                <span class="text-3xl font-display font-bold">52 000 kr</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-paper-200">Kr/ha inkl. schablon (52000 / 17455):</span>
                <span class="font-semibold">≈ 2,98 kr/ha</span>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center">
          <a href="/kontakt" class="btn-primary text-lg inline-flex items-center">
            Få exakt offert för ert område
            <svg class="ml-2 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
