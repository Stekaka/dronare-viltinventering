---
import Layout from '../layouts/Layout.astro';

const title = '404 — Sidan hittades inte | Älginventering.se';
const description = 'Sidan du söker hittades inte.';
---

<Layout title={title} description={description}>
  <section class="py-24">
    <div class="container-custom text-center">
      <div class="max-w-2xl mx-auto">
        <h1 class="text-6xl font-bold text-emerald-800 mb-4">404</h1>
        <h2 class="text-3xl font-bold text-stone-900 mb-6">Sidan hittades inte</h2>
        <p class="text-lg text-stone-700 mb-8">
          Sidan du letar efter existerar inte eller har flyttats. Prova att navigera till startsidan 
          eller använd menyn för att hitta det du söker.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn-primary">
            Till startsidan
          </a>
          <a href="/kontakt" class="btn-secondary">
            Kontakta oss
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
