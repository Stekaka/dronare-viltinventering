---
import Layout from '../layouts/Layout.astro';

const title = 'Jämför Metoder — Drönare vs Älgobs vs Spillning | Älginventering.se';
const description = 'Jämför olika inventeringsmetoder för älg: drönarinventering, älgobs och spillningsinventering. Se styrkor, svagheter och när varje metod passar bäst.';
---

<Layout title={title} description={description}>
  <section class="section-dark py-20 md:py-28">
    <div class="container-custom">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-paper-50 mb-6">Jämför metoder</h1>
      <p class="text-xl text-paper-200 max-w-3xl leading-relaxed">
        Olika metoder kompletterar varandra. Se styrkor och svagheter för att välja rätt kombination.
      </p>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-paper-50">
    <div class="container-custom">
      <div class="max-w-6xl mx-auto">
        
        <div class="card-elevated bg-moss-700 text-paper-50 p-8 mb-16">
          <h3 class="text-2xl font-display font-bold mb-3">Komplement, inte konkurrenter</h3>
          <p class="text-paper-100 text-lg leading-relaxed">
            Drönare, älgobs och spillningsinventering har olika styrkor. De kompletterar varandra — 
            kombinera metoder för bästa underlag till ÄFO och avskjutningsplanering.
          </p>
        </div>

        <!-- Method Cards - Visual Comparison -->
        <div class="grid lg:grid-cols-3 gap-8 mb-24">
          <!-- Drönarinventering -->
          <div class="card-elevated p-8 border-2 border-moss-600 relative">
            <div class="absolute -top-4 left-8 bg-moss-600 text-paper-50 px-4 py-1.5 text-sm font-semibold rounded-sm">
              DRÖNARE
            </div>
            <div class="mt-4 mb-8">
              <div class="w-16 h-16 bg-moss-600/10 border-2 border-moss-600 rounded-sm flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-moss-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
              </div>
              <h3 class="text-2xl font-display font-bold text-ink-900 mb-2">Termisk + Optisk</h3>
              <p class="text-charcoal-600">Provyteinventering med sensor och verifiering</p>
            </div>

            <div class="space-y-4 mb-8">
              <div>
                <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Styrkor</div>
                <ul class="space-y-2 text-sm text-charcoal-700">
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>~100% detektion i optimalt väder</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Objektiv, statistiskt beräknat konfidensintervall</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Bildbevis med GPS + tidsstämpel</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Snabb inventering stora arealer</span>
                  </li>
                </ul>
              </div>

              <div>
                <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Begränsningar</div>
                <ul class="space-y-2 text-sm text-charcoal-600">
                  <li>• Kostnad (ca 2–3 kr/ha)</li>
                  <li>• Komplement, ej officiell metod</li>
                  <li>• Kön/kalv kräver högre täckning</li>
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-paper-200">
              <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Bäst för</div>
              <p class="text-sm text-charcoal-700">Objektiv täthetsskattning, bildbevis för ÄFO, komplement när älgobs osäker</p>
            </div>
          </div>

          <!-- Älgobs -->
          <div class="card-elevated p-8">
            <div class="absolute -top-4 left-8 bg-charcoal-700 text-paper-50 px-4 py-1.5 text-sm font-semibold rounded-sm">
              ÄLGOBS
            </div>
            <div class="mt-4 mb-8">
              <div class="w-16 h-16 bg-charcoal-700/10 border-2 border-charcoal-700 rounded-sm flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-charcoal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h3 class="text-2xl font-display font-bold text-ink-900 mb-2">Jägarobservationer</h3>
              <p class="text-charcoal-600">Observationer under jakt och uppehåll</p>
            </div>

            <div class="space-y-4 mb-8">
              <div>
                <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Styrkor</div>
                <ul class="space-y-2 text-sm text-charcoal-700">
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Mycket bra för kön/kalv (direkt observation)</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Officiell metod sedan länge</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Kontinuerlig uppföljning år för år</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Ingen kostnad (jägarnas tid)</span>
                  </li>
                </ul>
              </div>

              <div>
                <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Begränsningar</div>
                <ul class="space-y-2 text-sm text-charcoal-600">
                  <li>• Varierar med jägarnas närvaro</li>
                  <li>• Subjektiv osäkerhet</li>
                  <li>• Ofta inget bildbevis</li>
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-paper-200">
              <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Bäst för</div>
              <p class="text-sm text-charcoal-700">Könskvot/kalvar, officiell rapportering, lokal kännedom, årlig uppföljning</p>
            </div>
          </div>

          <!-- Spillningsinventering -->
          <div class="card-elevated p-8">
            <div class="absolute -top-4 left-8 bg-charcoal-700 text-paper-50 px-4 py-1.5 text-sm font-semibold rounded-sm">
              SPILLNING
            </div>
            <div class="mt-4 mb-8">
              <div class="w-16 h-16 bg-charcoal-700/10 border-2 border-charcoal-700 rounded-sm flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-charcoal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path d="M3 12h18M9 5l7 7-7 7"/>
                </svg>
              </div>
              <h3 class="text-2xl font-display font-bold text-ink-900 mb-2">Spillningsräkning</h3>
              <p class="text-charcoal-600">Räkning av hopar i provytor, vår</p>
            </div>

            <div class="space-y-4 mb-8">
              <div>
                <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Styrkor</div>
                <ul class="space-y-2 text-sm text-charcoal-700">
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Officiell, godkänd metod</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Objektiv, statistiskt beräknat CI</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-4 h-4 text-moss-600 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Vinterutbredning, stora områden</span>
                  </li>
                </ul>
              </div>

              <div>
                <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Begränsningar</div>
                <ul class="space-y-2 text-sm text-charcoal-600">
                  <li>• Indirekt mått (spillning, ej älg)</li>
                  <li>• Ej möjligt för kön/kalv</li>
                  <li>• Kräver fältarbete</li>
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-paper-200">
              <div class="text-xs uppercase tracking-wider text-charcoal-500 font-semibold mb-1">Bäst för</div>
              <p class="text-sm text-charcoal-700">Officiell täthetsskattning, objektiv metod, stora landskap, vinterutbredning</p>
            </div>
          </div>
        </div>

        <!-- Recommendation -->
        <div class="card-elevated bg-gradient-to-br from-moss-700 via-moss-600 to-moss-700 text-paper-50 p-10">
          <h2 class="text-3xl font-display font-bold mb-4">Vår rekommendation</h2>
          <p class="text-lg text-paper-100 mb-6 leading-relaxed">
            <strong>Kombinera metoder för bästa beslutsunderlag.</strong> Fortsätt med älgobs och spillning 
            som grund — komplettera med drönare när ni behöver:
          </p>
          <ul class="grid md:grid-cols-2 gap-4">
            {[
              'Objektiv bekräftelse av älgobs-data',
              'Bildbevis för ÄFO-samråd',
              'Täthetsskattning med konfidensintervall',
              'Kartunderlag över älgens utbredning'
            ].map(item => (
              <li class="flex items-start">
                <svg class="w-6 h-6 text-paper-50 mr-3 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-dark py-20 md:py-28">
    <div class="container-custom text-center">
      <h2 class="text-4xl md:text-5xl font-display font-bold text-paper-50 mb-6">Diskutera vilken metod som passar er</h2>
      <p class="text-xl text-paper-200 mb-10 max-w-2xl mx-auto leading-relaxed">
        Vi hjälper er att välja rätt kombination av metoder för ert område och era mål.
      </p>
      <a href="/kontakt" class="btn-primary text-lg bg-paper-50 text-ink-900 hover:bg-paper-100">
        Boka samtal
      </a>
    </div>
  </section>
</Layout>
