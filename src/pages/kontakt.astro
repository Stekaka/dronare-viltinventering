---
import Layout from '../layouts/Layout.astro';

const title = 'Kontakt — Boka Samtal | Älginventering.se';
const description = 'Boka 15 minuters kostnadsfritt samtal. Vi går igenom ert område och tar fram en skräddarsydd offert.';
---

<Layout title={title} description={description}>
  <section class="bg-emerald-800 text-white py-16">
    <div class="container-custom">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Kontakt</h1>
      <p class="text-xl text-emerald-50 max-w-3xl">
        Boka 15 min — offert skräddarsydd för just ert område
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12">
        
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold text-stone-900 mb-6">Drönarkompaniet Norden AB</h2>
          <p class="text-stone-700 mb-8">
            Vi besvarar frågor och tar fram offert efter genomgång av ert specifika område. 
            Ring, maila eller boka ett kostnadsfritt samtal.
          </p>

          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-stone-600 mb-1">Telefon</div>
                <a href="tel:+46709780908" class="text-xl font-semibold text-emerald-700 hover:text-emerald-800">
                  0709-780 908
                </a>
                <p class="text-sm text-stone-600 mt-1">Vardagar 9–17</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-stone-600 mb-1">E-post</div>
                <a href="mailto:info@dronarkompaniet.se" class="text-xl font-semibold text-emerald-700 hover:text-emerald-800">
                  info@dronarkompaniet.se
                </a>
                <p class="text-sm text-stone-600 mt-1">Svar inom 24 timmar</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center mr-4 flex-shrink-0">
                <svg class="w-6 h-6 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-stone-600 mb-1">Webb</div>
                <a href="https://dronarkompaniet.se" target="_blank" rel="noopener" class="text-xl font-semibold text-emerald-700 hover:text-emerald-800">
                  dronarkompaniet.se
                </a>
                <p class="text-sm text-stone-600 mt-1">Fler drönartjänster</p>
              </div>
            </div>
          </div>

          <div class="mt-12 p-6 bg-emerald-50 rounded-lg">
            <h3 class="font-semibold text-emerald-900 mb-2">Täcker hela Sverige</h3>
            <p class="text-stone-700 text-sm">
              Vi har kapacitet över hela landet. Resor och boende tillkommer beroende på avstånd — 
              vi ger schablon i offert baserat på ert läge.
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-stone-100 p-8 rounded-lg">
          <h3 class="text-2xl font-bold text-stone-900 mb-6">Skicka meddelande</h3>
          <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-stone-700 mb-2">
                Namn *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2 border border-stone-300 rounded-md focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
              />
            </div>

            <div>
              <label for="organization" class="block text-sm font-medium text-stone-700 mb-2">
                Organisation / Jaktlag / ÄSO
              </label>
              <input
                type="text"
                id="organization"
                name="organization"
                class="w-full px-4 py-2 border border-stone-300 rounded-md focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-stone-700 mb-2">
                E-post *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2 border border-stone-300 rounded-md focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-stone-700 mb-2">
                Telefon
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-2 border border-stone-300 rounded-md focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
              />
            </div>

            <div>
              <label for="area" class="block text-sm font-medium text-stone-700 mb-2">
                Ungefärlig areal (ha)
              </label>
              <input
                type="number"
                id="area"
                name="area"
                placeholder="ex. 10000"
                class="w-full px-4 py-2 border border-stone-300 rounded-md focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-stone-700 mb-2">
                Meddelande *
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Beskriv kort ert område, målsättning och när ni vill genomföra inventeringen..."
                class="w-full px-4 py-2 border border-stone-300 rounded-md focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full">
              Skicka meddelande
            </button>

            <p class="text-xs text-stone-600 text-center">
              Vi svarar vanligen inom 24 timmar. Läs vår <a href="#" class="underline">integritetspolicy</a>.
            </p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-emerald-900 text-white py-16">
    <div class="container-custom text-center">
      <h2 class="text-3xl font-bold mb-4">Vill du veta mer först?</h2>
      <p class="text-xl text-emerald-100 mb-8">
        Läs mer om metodik, kostnad och hur vi jämför med andra metoder
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/metodik" class="btn-secondary border-white text-white hover:bg-white hover:text-emerald-900">
          Metodik
        </a>
        <a href="/kostnad" class="btn-secondary border-white text-white hover:bg-white hover:text-emerald-900">
          Kostnad
        </a>
        <a href="/faq" class="btn-secondary border-white text-white hover:bg-white hover:text-emerald-900">
          Vanliga frågor
        </a>
      </div>
    </div>
  </section>
</Layout>
