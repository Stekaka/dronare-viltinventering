---
import Layout from '../layouts/Layout.astro';
import HeroMedia from '../components/HeroMedia.astro';

const title = 'Älginventering med Termisk Drönare | Täthetsskattning med Konfidensintervall';
const description = 'Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning. I linje med SLU 2026.';
---

<Layout title={title} description={description}>
	<!-- Hero with thermal video -->
	<HeroMedia
		eyebrow="DRÖNARBASERAD VILTINVENTERING"
		posterSrc="/media/hero-thermal-poster.jpg"
		posterAlt="Termisk flygfoto från älginventering"
		videoMp4="/media/hero-thermal.mp4"
		videoWebm="/media/hero-thermal.webm"
		ctaHref="/kontakt"
		ctaLabel="Boka älginventering"
		secondaryHref="#metod"
		secondaryLabel="Läs om metoden"
		trustLine="Termisk detektion · Optisk verifiering · Manuell artkontroll — i linje med SLU 2026"
	>
		Älginventering med <span style="font-style: italic;">termisk drönare</span>
	</HeroMedia>

	<!-- Proof strip -->
	<div class="bg-bg-elevated border-y border-border py-12">
		<div class="container-site">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
				<div>
					<div class="text-3xl font-semibold text-text-primary mb-2">~100%</div>
					<div class="text-sm text-text-muted">detektion i optimal väder (SLU)</div>
				</div>
				<div>
					<div class="text-3xl font-semibold text-text-primary mb-2">Konfidensintervall</div>
					<div class="text-sm text-text-muted">inte en enskild siffra</div>
				</div>
				<div>
					<div class="text-3xl font-semibold text-text-primary mb-2">GPS + Bild</div>
					<div class="text-sm text-text-muted">per observation</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Introduction -->
	<div class="py-20">
		<div class="container-site max-w-3xl text-center">
			<p class="text-lg text-text-primary leading-relaxed">
				Provyteinventering av älg med termisk drönarkamera — random plots för täthetsskattning 
				med konfidensintervall. Varje värmesignatur zoomas in optiskt och artbestäms manuellt. 
				Ett komplement till älgobs och spillning, byggt på samma kunskap som SLU:s utvärdering 2026.
			</p>
		</div>
	</div>

	<!-- 3 Value Cards -->
	<div class="py-20 border-t border-border">
		<div class="container-site">
			<div class="text-center mb-16">
				<span class="eyebrow mb-4 block">TRE STEG I PROCESSEN</span>
				<h2 class="text-display font-semibold text-text-primary mb-4">
					Från termisk signal till verifierad observation
				</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Card 1: Thermal -->
				<div class="card">
					<div class="aspect-video mb-6 overflow-hidden rounded-lg border border-border">
						<img src="/media/thermal-alg-1.jpg" alt="Termisk bild av älg" class="w-full h-full object-cover" />
					</div>
					<h3 class="text-xl font-semibold text-text-primary mb-3">01 — Termisk detektion</h3>
					<p class="text-text-muted leading-relaxed">
						Värmekameran fångar kroppsvärme genom vegetation. SLU:s GPS-validering visar nästan 100% detektion 
						i kallt molnigt vinterväder.
					</p>
				</div>
				<!-- Card 2: Optical -->
				<div class="card">
					<div class="aspect-video mb-6 overflow-hidden rounded-lg border border-border">
						<img src="/media/optisk-alg-zoom.jpg" alt="Optisk zoom på älg" class="w-full h-full object-cover" />
					</div>
					<h3 class="text-xl font-semibold text-text-primary mb-3">02 — Optisk verifiering</h3>
					<p class="text-text-muted leading-relaxed">
						Varje värmesignatur zoomas in med optisk kamera. Piloten artbestämmer manuellt — ingen automatisk 
						AI-klassificering.
					</p>
				</div>
				<!-- Card 3: Report -->
				<div class="card">
					<div class="aspect-video mb-6 overflow-hidden rounded-lg border border-border">
						<img src="/media/rapport-karta.png" alt="Rapport med karta" class="w-full h-full object-cover" />
					</div>
					<h3 class="text-xl font-semibold text-text-primary mb-3">03 — Rapport & karta</h3>
					<p class="text-text-muted leading-relaxed">
						Täthetsskattning med konfidensintervall, karta med GPS-koordinater och bildbevis per observation. 
						Levereras digitalt.
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- 01/02/03 Workflow -->
	<div id="metod" class="py-20 bg-bg-elevated border-y border-border scroll-mt-20">
		<div class="container-site">
			<div class="text-center mb-16 max-w-3xl mx-auto">
				<span class="eyebrow mb-4 block">PROVYTEINVENTERING</span>
				<h2 class="text-display font-semibold text-text-primary mb-4">
					Från bokning till rapport
				</h2>
				<p class="text-text-muted leading-relaxed">
					Random plots över fastigheten, flögen när kylan ger bäst kontrast. Täthetsskattning 
					med konfidensintervall — inte en exakt siffra.
				</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="card">
					<div class="font-mono text-sm text-text-muted mb-3">01</div>
					<h3 class="text-lg font-semibold text-text-primary mb-3">Boka & planera</h3>
					<p class="text-sm text-text-muted leading-relaxed">
						Ni skickar fastighetens gränser. Vi planerar provytor och flyglinjer utifrån terräng och väderprognos.
					</p>
				</div>
				<div class="card">
					<div class="font-mono text-sm text-text-muted mb-3">02</div>
					<h3 class="text-lg font-semibold text-text-primary mb-3">Flygning</h3>
					<p class="text-sm text-text-muted leading-relaxed">
						Termisk kamera flyger provytorna dagtid under vinterhalvåret, när kylan ger tillräcklig kontrast.
					</p>
				</div>
				<div class="card">
					<div class="font-mono text-sm text-text-muted mb-3">03</div>
					<h3 class="text-lg font-semibold text-text-primary mb-3">Analys</h3>
					<p class="text-sm text-text-muted leading-relaxed">
						Varje värmesignatur zoomas in optiskt och artbestäms manuellt — ingen automatisk klassificering.
					</p>
				</div>
				<div class="card">
					<div class="font-mono text-sm text-text-muted mb-3">04</div>
					<h3 class="text-lg font-semibold text-text-primary mb-3">Rapport</h3>
					<p class="text-sm text-text-muted leading-relaxed">
						Täthetsskattning med konfidensintervall, kartor, GPS-koordinater och bildbevis — levererat digitalt.
					</p>
				</div>
			</div>
			<div class="text-center mt-12">
				<a href="/metodik" class="text-sm text-text-primary hover:underline">
					Läs mer om metoden och den vetenskapliga grunden →
				</a>
			</div>
		</div>
	</div>

	<!-- Coverage / Case panel -->
	<div class="py-20">
		<div class="container-site">
			<div class="text-center mb-16">
				<span class="eyebrow mb-4 block">NYLIGEN GENOMFÖRT</span>
				<h2 class="text-display font-semibold text-text-primary">
					Ett av våra senaste uppdrag
				</h2>
			</div>
			<div class="grid md:grid-cols-2 gap-0 max-w-5xl mx-auto card overflow-hidden">
				<div class="p-2">
					<img src="/media/sotenas-flygunderlag.jpg" alt="Flygplaneringsunderlag för Sotenäs" class="w-full h-full object-cover rounded-lg border border-border" />
				</div>
				<div class="p-8">
					<span class="font-mono text-xs text-text-muted uppercase tracking-wider">SOTENÄS ÄLGSKÖTSELOMRÅDE</span>
					<p class="text-lg text-text-primary my-6 leading-relaxed">
						Kustskog, vinter 2025 — 41 provytor över 10 132 hektar. Täckningsgrad 40,4% för täthetsskattning.
					</p>
					<div class="grid grid-cols-2 gap-6 mb-6">
						<div>
							<div class="text-3xl font-semibold text-text-primary">3,73</div>
							<div class="text-sm text-text-muted">VMK (viltmarkskvot)</div>
						</div>
						<div>
							<div class="text-3xl font-semibold text-text-primary">41</div>
							<div class="text-sm text-text-muted">provytor</div>
						</div>
					</div>
					<a href="/case" class="text-sm text-text-primary hover:underline">
						Läs mer om uppdraget →
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- Demo CTA -->
	<div class="py-20 border-t border-border">
		<div class="container-site max-w-3xl text-center">
			<span class="eyebrow mb-4 block">REDO ATT INVENTERA ER MARK?</span>
			<h2 class="text-display font-semibold text-text-primary mb-6">
				Skicka in fastighetens uppgifter så återkommer vi med offert
			</h2>
			<p class="text-text-muted leading-relaxed mb-8">
				Vi förklarar metoden, går igenom priset och föreslår flygfönster som passar ert område.
			</p>
			<div class="flex gap-4 justify-center flex-wrap">
				<a href="/kontakt" class="btn-primary">Begär offert</a>
				<a href="/kostnad" class="btn-secondary">Se priskalkylator</a>
			</div>
		</div>
	</div>
</Layout>
