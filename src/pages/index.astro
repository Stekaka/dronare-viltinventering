---
import Layout from '../layouts/Layout.astro';
import PriceCalculator from '../components/PriceCalculator.astro';

const title = 'Älginventering med Termisk Drönare | Täthetsskattning med Konfidensintervall';
const description = 'Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning. I linje med SLU 2026.';
---

<Layout title={title} description={description}>
  <!-- Hero - ONE dominant message -->
  <section class="relative overflow-hidden pt-24 pb-32 md:pt-32 md:pb-48">
    <div class="container-custom">
      <div class="max-w-4xl">
        <p class="eyebrow mb-6">DRÖN ARB ASERAD VILTINVENTERING</p>
        <h1 class="text-display md:text-display-lg lg:text-display-xl font-semibold text-text-primary mb-6">
          Älginventering med termisk drönare
        </h1>
        <p class="text-xl md:text-2xl text-text-secondary mb-10 max-w-2xl leading-relaxed">
          Täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning.
        </p>
        
        <!-- Single clear CTA -->
        <div class="flex flex-col sm:flex-row gap-4 mb-16">
          <a href="/kostnad" class="btn-primary text-base px-8 py-3">
            Beräkna kostnad
          </a>
          <a href="/metodik" class="btn-secondary text-base px-8 py-3">
            Läs om metodik
          </a>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-8 items-center text-sm text-text-tertiary">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Baserat på SLU-studie 2026</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>~100% detektion optimalt väder</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>Manuell artkontroll</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product proof section -->
  <section class="py-24 md:py-32 border-t border-border-primary">
    <div class="container-custom">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card">
          <p class="eyebrow mb-3">01 — DETEKTERING</p>
          <h3 class="text-xl font-semibold text-text-primary mb-3">Termisk sensor</h3>
          <p class="text-text-secondary leading-relaxed">
            Fångar kroppsvärme genom vegetation. SLU:s GPS-validering visar nästan 100% detektion i optimala förhållanden.
          </p>
        </div>

        <div class="card">
          <p class="eyebrow mb-3">02 — VERIFIERING</p>
          <h3 class="text-xl font-semibold text-text-primary mb-3">Optisk kamera</h3>
          <p class="text-text-secondary leading-relaxed">
            Högupplöst optisk bild med GPS-koordinat och tidsstämpel för varje observation. Manuell artkontroll av erfaren personal.
          </p>
        </div>

        <div class="card">
          <p class="eyebrow mb-3">03 — ANALYS</p>
          <h3 class="text-xl font-semibold text-text-primary mb-3">Täthetsskattning</h3>
          <p class="text-text-secondary leading-relaxed">
            Konfidensintervall beräknat enligt vetenskaplig metodik. Komplett rapport med karta och bildbevis.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Method steps - numbered process -->
  <section class="py-24 md:py-32 bg-bg-secondary border-y border-border-primary">
    <div class="container-custom">
      <div class="max-w-3xl mb-16">
        <p class="eyebrow mb-4">PROCESSEN</p>
        <h2 class="text-display-sm md:text-display font-semibold text-text-primary mb-4">
          Från brief till rapport
        </h2>
        <p class="text-lg text-text-secondary">
          Fem steg med tydlig metodik och transparent genomförande
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl">
        {[
          { num: '01', title: 'Brief', desc: 'Areal, plats, arter. Vi föreslår täckningsgrad baserat på ert område.' },
          { num: '02', title: 'Provytor', desc: 'Slumpmässigt urval över hela området enligt statistisk metodik.' },
          { num: '03', title: 'Flygning', desc: 'Termisk detektion följt av optisk verifiering med GPS-loggning.' },
          { num: '04', title: 'Analys', desc: 'Manuell artkontroll. Täthetsskattning med konfidensintervall.' },
          { num: '05', title: 'Rapport', desc: 'Karta, bildbevis och metodbeskrivning för ÄFO-rapportering.' },
        ].map(step => (
          <div class="card">
            <div class="text-xs font-medium text-accent-primary mb-2">{step.num}</div>
            <h3 class="text-lg font-semibold text-text-primary mb-2">{step.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <a href="/metodik" class="btn-secondary">
          Se fullständig metodik
        </a>
      </div>
    </div>
  </section>

  <!-- Calculator section -->
  <section class="py-24 md:py-32">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <p class="eyebrow mb-4">KOSTNADSKALKYLATOR</p>
          <h2 class="text-display-sm md:text-display font-semibold text-text-primary mb-4">
            Beräkna kostnad för ert område
          </h2>
          <p class="text-lg text-text-secondary max-w-2xl mx-auto">
            Transparent prissättning. Offert efter genomgång av ert specifika område.
          </p>
        </div>
        <PriceCalculator />
      </div>
    </div>
  </section>

  <!-- For whom section -->
  <section class="py-24 md:py-32 bg-bg-secondary border-y border-border-primary">
    <div class="container-custom">
      <div class="max-w-3xl mb-12">
        <p class="eyebrow mb-4">MÅLGRUPPER</p>
        <h2 class="text-display-sm md:text-display font-semibold text-text-primary">
          För dig som arbetar med viltförvaltning
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { title: 'Jaktlag', href: '/for/jaktlag', desc: 'Komplettera älgobs med objektiv täthetsskattning' },
          { title: 'ÄSO', href: '/for/aso', desc: 'Underlag för ÄFO-samråd med vetenskaplig metodik' },
          { title: 'ÄFO', href: '/for/afo', desc: 'Helhetsbild för evidensbaserade beslut' },
          { title: 'Markägare', href: '/for/markagare', desc: 'Dokumentera viltpåverkan på skog' }
        ].map(item => (
          <a href={item.href} class="card group">
            <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent-primary transition-colors">{item.title}</h3>
            <p class="text-sm text-text-secondary leading-relaxed mb-3">{item.desc}</p>
            <div class="text-sm text-text-tertiary group-hover:text-accent-primary transition-colors inline-flex items-center">
              Läs mer
              <svg class="ml-1 w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <section class="py-24 md:py-32">
    <div class="container-custom text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-display-sm md:text-display font-semibold text-text-primary mb-4">
          Redo att börja?
        </h2>
        <p class="text-lg text-text-secondary mb-8">
          Boka 15 min för en genomgång av ert område
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/kontakt" class="btn-primary text-base px-8 py-3">
            Boka samtal
          </a>
          <a href="/faq" class="btn-secondary text-base px-8 py-3">
            Vanliga frågor
          </a>
        </div>
        <p class="mt-8 text-sm text-text-tertiary">
          Drönarkompaniet Norden AB · <a href="tel:+46709780908" class="text-text-secondary hover:text-text-primary transition-colors">0709-780 908</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
