---
import Layout from '../layouts/Layout.astro';
import PriceCalculator from '../components/PriceCalculator.astro';

const title = 'Älginventering med Termisk Drönare | Täthetsskattning med Konfidensintervall';
const description = 'Älginventering med termisk drönare — täthetsskattning med konfidensintervall, karta och bildbevis. Komplement till älgobs och spillning. I linje med SLU 2026.';
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-emerald-900 via-emerald-800 to-stone-900 text-white">
    <div class="absolute inset-0 bg-[url('/images/forest-pattern.svg')] opacity-5"></div>
    <div class="container-custom py-20 md:py-32 relative z-10">
      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          Älginventering med termisk drönare
        </h1>
        <p class="text-xl md:text-2xl text-emerald-50 mb-8 leading-relaxed">
          Täthetsskattning med konfidensintervall, karta och bildbevis — komplement till älgobs och spillning.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/kostnad" class="btn-primary bg-white text-emerald-800 hover:bg-emerald-50 text-lg px-8 py-4 inline-flex items-center justify-center">
            Beräkna kostnad
            <svg class="ml-2 -mr-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="/metodik" class="btn-secondary border-white text-white hover:bg-white hover:text-emerald-800 text-lg px-8 py-4 inline-flex items-center justify-center">
            Läs om metodik
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badge -->
  <section class="bg-emerald-50 border-b border-emerald-100">
    <div class="container-custom py-8">
      <p class="text-center text-stone-700">
        <strong class="text-emerald-800">Metodiken bygger på samma kunskap som SLU:s utvärdering 2026.</strong> 
        Hofmeester m.fl. (2026). Inventering av älg med drönare. Rapport 2026.2, SLU.
      </p>
    </div>
  </section>

  <!-- Differentiators -->
  <section class="py-16 md:py-24">
    <div class="container-custom">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-stone-900 mb-12">
        Hur vi arbetar
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-900 mb-3">Termisk detektion</h3>
          <p class="text-stone-600">
            Nästan 100 % detektion i kalla, molniga vinterförhållanden enligt SLU:s GPS-validering. 
            Fångar kroppsvärme genom vegetation.
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-900 mb-3">Optisk verifiering</h3>
          <p class="text-stone-600">
            Varje termisk detektion verifieras med högupplöst optisk kamera. GPS-koordinat och tidsstämpel för varje observation.
          </p>
        </div>

        <div class="text-center">
          <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-stone-900 mb-3">Manuell artkontroll</h3>
          <p class="text-stone-600">
            Erfaren personal granskar varje bild och bestämmer art. AI stödjer detektering — människan bestämmer arten.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Method Steps -->
  <section class="bg-stone-100 py-16 md:py-24">
    <div class="container-custom">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-stone-900 mb-4">
        Så går inventeringen till
      </h2>
      <p class="text-center text-stone-600 mb-12 max-w-2xl mx-auto">
        Från brief till rapport — fem steg med tydlig metodik
      </p>
      
      <div class="grid md:grid-cols-5 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <div class="text-emerald-700 font-bold text-lg mb-2">01 Brief</div>
          <h3 class="font-semibold text-stone-900 mb-2">Planering</h3>
          <p class="text-sm text-stone-600">
            Areal, plats, önskade arter. Vi föreslår täckningsgrad och antal flygdagar baserat på ert område.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm">
          <div class="text-emerald-700 font-bold text-lg mb-2">02 Provytor</div>
          <h3 class="font-semibold text-stone-900 mb-2">Slumpmässigt urval</h3>
          <p class="text-sm text-stone-600">
            Provytor placeras slumpmässigt över hela området — inte där ni "vet" att älgen finns.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm">
          <div class="text-emerald-700 font-bold text-lg mb-2">03 Flygning</div>
          <h3 class="font-semibold text-stone-900 mb-2">Termisk + optisk</h3>
          <p class="text-sm text-stone-600">
            Termisk sensor för detektion, optisk för verifiering. GPS + tidsstämpel. Bäst i kallt, molnigt, vinterväder.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm">
          <div class="text-emerald-700 font-bold text-lg mb-2">04 Analys</div>
          <h3 class="font-semibold text-stone-900 mb-2">Manuell artkontroll</h3>
          <p class="text-sm text-stone-600">
            Täthetsskattning med konfidensintervall — inte bara en siffra. Varje observation verifieras av människa.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm">
          <div class="text-emerald-700 font-bold text-lg mb-2">05 Rapport</div>
          <h3 class="font-semibold text-stone-900 mb-2">Beslutsunderlag</h3>
          <p class="text-sm text-stone-600">
            Rapport med täthet + konfidensintervall, karta över provytor, bildbevis. Komplement till älgobs och spillning.
          </p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/metodik" class="btn-secondary">
          Fördjupa dig i metodiken
        </a>
      </div>
    </div>
  </section>

  <!-- Calculator Preview -->
  <section class="py-16 md:py-24">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-4">
            Beräkna kostnad för ert område
          </h2>
          <p class="text-lg text-stone-600">
            Få en snabb orientering baserat på areal och täckningsgrad. Offert efter genomgång av ert specifika område.
          </p>
        </div>
        <PriceCalculator />
      </div>
    </div>
  </section>

  <!-- For Whom Section -->
  <section class="bg-emerald-900 text-white py-16 md:py-24">
    <div class="container-custom">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12">
        För dig som arbetar med viltförvaltning
      </h2>
      <div class="grid md:grid-cols-4 gap-6">
        <a href="/for/jaktlag" class="bg-emerald-800 hover:bg-emerald-700 p-6 rounded-lg transition-colors">
          <h3 class="text-xl font-semibold mb-3">Jaktlag</h3>
          <p class="text-emerald-100 text-sm">
            Komplettera älgobs med objektiv data. Fatta beslut om avskjutning på säkrare grund.
          </p>
          <div class="mt-4 text-emerald-300 text-sm font-medium">
            Läs mer →
          </div>
        </a>

        <a href="/for/aso" class="bg-emerald-800 hover:bg-emerald-700 p-6 rounded-lg transition-colors">
          <h3 class="text-xl font-semibold mb-3">ÄSO</h3>
          <p class="text-emerald-100 text-sm">
            Underlag för ÄFO-samråd med vetenskaplig metodik. Konfidensintervall och kartunderlag.
          </p>
          <div class="mt-4 text-emerald-300 text-sm font-medium">
            Läs mer →
          </div>
        </a>

        <a href="/for/afo" class="bg-emerald-800 hover:bg-emerald-700 p-6 rounded-lg transition-colors">
          <h3 class="text-xl font-semibold mb-3">ÄFO</h3>
          <p class="text-emerald-100 text-sm">
            Få en helhetsbild över älgförekomsten. Komplement till spillning och älgobs för evidensbaserade beslut.
          </p>
          <div class="mt-4 text-emerald-300 text-sm font-medium">
            Läs mer →
          </div>
        </a>

        <a href="/for/markagare" class="bg-emerald-800 hover:bg-emerald-700 p-6 rounded-lg transition-colors">
          <h3 class="text-xl font-semibold mb-3">Markägare</h3>
          <p class="text-emerald-100 text-sm">
            Dokumentera viltpåverkan på skog. Underlag för samtal med jaktlag och skogsvård.
          </p>
          <div class="mt-4 text-emerald-300 text-sm font-medium">
            Läs mer →
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-24 bg-stone-50">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 mb-6">
        Redo att börja?
      </h2>
      <p class="text-xl text-stone-600 mb-8 max-w-2xl mx-auto">
        Boka 15 min — offert skräddarsydd för just ert område.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/kontakt" class="btn-primary text-lg px-8 py-4">
          Boka kostnadsfritt samtal
        </a>
        <a href="/faq" class="btn-secondary text-lg px-8 py-4">
          Läs vanliga frågor
        </a>
      </div>
      <p class="mt-8 text-stone-600">
        Drönarkompaniet Norden AB · <a href="tel:+46709780908" class="text-emerald-700 hover:underline">0709-780 908</a> · 
        <a href="mailto:info@dronarkompaniet.se" class="text-emerald-700 hover:underline">info@dronarkompaniet.se</a>
      </p>
    </div>
  </section>
</Layout>
