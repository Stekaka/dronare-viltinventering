---
import LogoMark from './LogoMark.astro';
---

<footer
  data-screen-label="Footer"
  style="padding:56px clamp(20px, 6vw, 64px);background:#242b1e;display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:40px"
>
  <div>
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px">
      <LogoMark size={44} />
      <span style="font:700 19px 'Spectral',serif;color:#efe8d8">Älginventering.se</span>
    </div>
    <p style="font:400 13.5px/1.6 'Karla',sans-serif;color:#a39a7c;max-width:280px;margin:0">
      En specialistsajt för viltinventering med drönare. Uppdrag genomförs av Drönarkompaniet.
    </p>
  </div>
  <div>
    <span style="font:600 12px 'Karla',sans-serif;color:#7a7256;letter-spacing:0.06em;text-transform:uppercase"
      >Tjänster</span
    >
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:16px">
      <a href="/alginventering" style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif"
        >Älginventering</a
      >
      <a href="/viltinventering" style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif"
        >Vildsvinsinventering</a
      >
      <a href="/viltinventering" style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif"
        >Rådjursinventering</a
      >
      <a href="/viltinventering" style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif"
        >Kronviltsinventering</a
      >
    </div>
  </div>
  <div>
    <span style="font:600 12px 'Karla',sans-serif;color:#7a7256;letter-spacing:0.06em;text-transform:uppercase"
      >Företaget</span
    >
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:16px">
      <a href="/metod-och-vetenskap" style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif"
        >Metod &amp; vetenskaplig grund</a
      >
      <a
        href="https://www.dronarkompaniet.se"
        style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif">Drönarkompaniet.se</a
      >
      <a href="#kontakt" style="color:#d8d2bc;text-decoration:none;font:400 14px 'Karla',sans-serif">Kontakt</a>
    </div>
  </div>
  <div>
    <span style="font:600 12px 'Karla',sans-serif;color:#7a7256;letter-spacing:0.06em;text-transform:uppercase"
      >Kontakt</span
    >
    <div style="display:flex;flex-direction:column;gap:10px;margin-top:16px">
      <span style="color:#d8d2bc;font:400 14px 'Karla',sans-serif">info@alginventering.se</span>
      <span style="color:#d8d2bc;font:400 14px 'Karla',sans-serif">0709-780908</span>
      <span style="color:#d8d2bc;font:400 14px 'Karla',sans-serif">Hela Sverige</span>
      <a
        href="https://viltanalys.se"
        target="_blank"
        rel="noopener"
        style="color:#c9973f;text-decoration:none;font:600 13px 'Karla',sans-serif;margin-top:6px"
        >Rapportsystemet Viltanalys ↗</a
      >
    </div>
  </div>
</footer>
