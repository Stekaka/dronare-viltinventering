---
interface Props {
  active?: 'alg' | 'vilt' | 'metod' | null;
}

const { active = null } = Astro.props;

const navLink = (isActive: boolean) =>
  isActive
    ? "text-decoration:none;font:600 13.5px 'Karla',sans-serif;letter-spacing:0.03em;text-transform:uppercase;color:#7a5230;border-bottom:2px solid #7a5230;padding-bottom:2px"
    : "text-decoration:none;font:600 13.5px 'Karla',sans-serif;letter-spacing:0.03em;text-transform:uppercase;color:#2b3324";
---

<header class="site-header" data-screen-label="Header">
  <a href="/" class="site-logo">
    <span style="font:700 24px 'Spectral',serif;color:#2b3324">Älginventering</span>
  </a>
  <nav aria-label="Huvudmeny" class="site-nav">
    <a href="/alginventering" style={navLink(active === 'alg')}>Älg</a>
    <a href="/viltinventering" style={navLink(active === 'vilt')}>Övrigt vilt</a>
    <a href="/metod-och-vetenskap" style={navLink(active === 'metod')}>Metod &amp; SLU</a>
    <a href="/#pris" style={navLink(false)}>Pris</a>
    <a href="#kontakt" class="site-cta">Begär offert</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    row-gap: 12px;
    padding: 20px clamp(20px, 6vw, 64px);
    background: #efe8d8;
    border-bottom: 2px solid #2b3324;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .site-logo {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    flex: none;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 34px;
    flex-wrap: wrap;
    row-gap: 10px;
  }
  .site-cta {
    text-decoration: none;
    border: 1.5px solid #2b3324;
    color: #2b3324;
    padding: 10px 22px;
    font: 600 13px 'Karla', sans-serif;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .site-header {
      padding: 16px 20px;
    }
    .site-nav {
      gap: 16px 20px;
    }
    .site-nav a:not(.site-cta) {
      font-size: 12.5px !important;
    }
    .site-cta {
      padding: 9px 16px;
      font-size: 12px;
    }
  }
</style>
