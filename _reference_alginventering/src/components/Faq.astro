---
interface Item {
  q: string;
  a: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  items: Item[];
  background?: string;
}

const { eyebrow, heading, items, background = '#efe8d8' } = Astro.props;
---

<div data-screen-label="FAQ" style={`padding:110px clamp(20px, 6vw, 64px);background:${background};border-top:2px solid #2b3324`}>
  <div style="text-align:center;margin-bottom:56px">
    <span style="font:600 12.5px 'Karla',sans-serif;color:#6b6142;letter-spacing:0.1em;text-transform:uppercase"
      >{eyebrow}</span
    >
    <h2 style="font:600 40px 'Spectral',serif;color:#242b1e;margin:14px 0 0">{heading}</h2>
  </div>
  <div style="max-width:820px;margin:0 auto;display:flex;flex-direction:column">
    {items.map((item, i) => (
      <div style={`padding:26px 0;${i < items.length - 1 ? 'border-bottom:1px solid rgba(43,51,36,0.2)' : ''}`}>
        <h3 style="font:600 17px 'Spectral',serif;color:#242b1e;margin:0 0 8px">{item.q}</h3>
        <p style="font:400 15px/1.6 'Karla',sans-serif;color:#5a5138;margin:0">{item.a}</p>
      </div>
    ))}
  </div>
</div>
