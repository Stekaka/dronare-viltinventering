---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:repeating-linear-gradient(135deg, rgba(43,51,36,0.06), rgba(43,51,36,0.06) 10px, transparent 10px, transparent 20px);text-align:center;padding:16px;box-sizing:border-box"
>
  <span style="font:400 13px italic 'Spectral',serif;color:#6b6142">{label}</span>
</div>
