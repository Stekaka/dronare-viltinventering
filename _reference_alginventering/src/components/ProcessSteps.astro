---
interface Step {
  mark: string;
  title: string;
  body: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  heading: string;
  steps: Step[];
}

const { id, eyebrow, heading, steps } = Astro.props;
---

<div
  id={id}
  data-screen-label="Metod"
  style="padding:100px clamp(20px, 6vw, 64px);background:#efe8d8;border-top:2px solid #2b3324;border-bottom:2px solid #2b3324;scroll-margin-top:90px"
>
  <div style="text-align:center;margin-bottom:60px">
    <span style="font:600 12.5px 'Karla',sans-serif;color:#6b6142;letter-spacing:0.1em;text-transform:uppercase"
      >{eyebrow}</span
    >
    <h2 style="font:600 40px 'Spectral',serif;color:#242b1e;margin:14px 0 0">{heading}</h2>
  </div>
  <div
    style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:1px;background:rgba(43,51,36,0.3);border:1px solid rgba(43,51,36,0.3);max-width:1200px;margin:0 auto"
  >
    {steps.map((step) => (
      <div style="padding:28px 26px 32px;background:#efe8d8">
        <span style="font:400 14px italic 'Spectral',serif;color:#7a5230">{step.mark}</span>
        <h3 style="font:600 18px 'Spectral',serif;color:#242b1e;margin:10px 0">{step.title}</h3>
        <p style="font:400 14px/1.6 'Karla',sans-serif;color:#5a5138;margin:0">{step.body}</p>
      </div>
    ))}
  </div>
</div>
