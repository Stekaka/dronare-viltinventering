---
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  jsonLd?: object[];
}

const { title, description, path, image = '/media/og-image.jpg', jsonLd = [] } = Astro.props;
const canonical = `https://alginventering.se${path}`;
const ogImage = `https://alginventering.se${image}`;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2b3324" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Älginventering.se" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Karla:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <style is:global>
      body {
        margin: 0;
        background: #faf6ea;
        font-family: 'Karla', sans-serif;
      }
      a {
        color: #7a5230;
      }
      a:hover {
        color: #5a3c22;
      }
      ::selection {
        background: #2b3324;
        color: #efe8d8;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
